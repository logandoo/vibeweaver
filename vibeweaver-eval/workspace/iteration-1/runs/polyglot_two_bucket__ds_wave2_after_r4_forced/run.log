import sys
sys.path.insert(0, "/Users/logan/Documents/DEV/SKILLS/vibeweaver-repo/vibeweaver-eval/workspace/iteration-1/runs/polyglot_two_bucket__ds_wave2_after_r4_forced")

import two_bucket


# ---- independent reference: plain breadth-first search, written separately
# ---- (self-checked against the canonical cases before it is trusted)
from collections import deque as _deque

def _ref(b1, b2, goal, start):
    init = (b1, 0) if start == "one" else (0, b2)
    if init[0] == goal:
        return (1, "one", init[1])
    if init[1] == goal:
        return (1, "two", init[0])
    bad = (0, b2) if start == "one" else (b1, 0)
    seen = {init}
    q = _deque([(init, 1)])
    while q:
        (a, b), m = q.popleft()
        for na, nb in (
            (b1, b), (a, b2), (0, b), (a, 0),
            (a - min(a, b2 - b), b + min(a, b2 - b)),
            (a + min(b, b1 - a), b - min(b, b1 - a)),
        ):
            if (na, nb) in seen or (na, nb) == bad:
                continue
            if na == goal:
                return (m + 1, "one", nb)
            if nb == goal:
                return (m + 1, "two", na)
            seen.add((na, nb))
            q.append(((na, nb), m + 1))
    raise ValueError


# ---- self-check reference against canonical cases
CANON = [
    ((3, 5, 1, "one"), (4, "one", 5)),
    ((3, 5, 1, "two"), (8, "two", 3)),
    ((7, 11, 2, "one"), (14, "one", 11)),
    ((7, 11, 2, "two"), (18, "two", 7)),
    ((1, 3, 3, "two"), (1, "two", 0)),
    ((2, 3, 3, "one"), (2, "two", 2)),
    ((5, 1, 2, "one"), (6, "one", 1)),
    ((3, 15, 9, "one"), (6, "two", 0)),
    ((6, 15, 9, "one"), (10, "two", 0)),
]
CANON_RAISE = [(6, 15, 5, "one"), (5, 7, 8, "one")]

ref_ok = True
for args, want in CANON:
    if _ref(*args) != want:
        print(f"REF-SELF-CHECK FAIL {args}: {_ref(*args)} != {want}")
        ref_ok = False
for args in CANON_RAISE:
    try:
        _ref(*args)
        print(f"REF-SELF-CHECK FAIL {args}: expected ValueError")
        ref_ok = False
    except ValueError:
        pass
if not ref_ok:
    print("REFERENCE FAILED SELF-CHECK — aborting sweep")
    sys.exit(2)
print(f"reference self-check OK ({len(CANON)} value cases, {len(CANON_RAISE)} raise cases)")


# ---- differential sweep
from math import gcd
mismatch = 0
compared = 0
for b1 in range(1, 9):
    for b2 in range(1, 9):
        for start in ("one", "two"):
            for goal in range(1, b1 + b2 + 1):
                compared += 1
                want_raise = goal > max(b1, b2) or goal % gcd(b1, b2) != 0
                try:
                    want = _ref(b1, b2, goal, start)
                    got_raise = False
                except ValueError:
                    want = None
                    got_raise = True
                try:
                    got = two_bucket.measure(b1, b2, goal, start)
                    got_raise = False
                except ValueError:
                    got = None
                    got_raise = True
                if got_raise != got_raise or want != got:
                    mismatch += 1
                    if mismatch <= 10:
                        print(f"MISMATCH b1={b1} b2={b2} start={start} goal={goal}: want={want} (raise={got_raise}) got={got} (raise={got_raise})")
if mismatch:
    print(f"DIFFERENTIAL SWEEP FAIL: {mismatch}/{compared} mismatches")
    sys.exit(1)
print(f"DIFFERENTIAL SWEEP PASS: {compared} inputs, 0 mismatches")
sys.exit(0)
