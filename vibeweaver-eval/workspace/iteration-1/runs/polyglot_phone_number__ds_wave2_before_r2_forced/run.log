import phone_number as p

cases = [
    ('+1 (613)-995-0253', '6139950253'),
    ('613-995-0253', '6139950253'),
    ('1 613 995 0253', '6139950253'),
    ('613.995.0253', '6139950253'),
    ('(223) 456-7890', '2234567890'),
    ('223.456.7890', '2234567890'),
    ('223 456   7890   ', '2234567890'),
    ('12234567890', '2234567890'),
    ('+1 (223) 456-7890', '2234567890'),
]
for raw, expected in cases:
    got = p.PhoneNumber(raw).number
    assert got == expected, (raw, got, expected)
    print(f'PASS clean: {raw!r} -> {got!r}')

assert p.PhoneNumber('(223) 456-7890').area_code() == '223'
assert p.PhoneNumber('(223) 456-7890').exchange_code() == '456'
assert p.PhoneNumber('313-462-9030').pretty() == '(313)-462-9030'
print('PASS area_code / exchange_code / pretty')

bads = [
    '123456789',            # 9 digits
    '22234567890',          # 11 digits not starting with 1
    '321234567890',         # 12 digits
    '523-abc-7890',         # letters
    '523-@:!-7890',         # punctuation
    '(023) 456-7890',       # area code starts 0
    '(123) 456-7890',       # area code starts 1
    '(223) 056-7890',       # exchange starts 0
    '(223) 156-7890',       # exchange starts 1
    '1 (023) 456-7890',     # 11-digit with bad area
    '1 (223) 056-7890',     # 11-digit with bad exchange
    'letters',
]
for bad in bads:
    try:
        p.PhoneNumber(bad).number
    except ValueError:
        print(f'PASS raises: {bad!r}')
    else:
        raise AssertionError(f'expected ValueError for {bad!r}')

print('ALL PASS')
"
