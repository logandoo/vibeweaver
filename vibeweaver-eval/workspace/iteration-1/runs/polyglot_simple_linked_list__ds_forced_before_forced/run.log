from simple_linked_list import LinkedList, EmptyListException

# Constructor + len
assert len(LinkedList()) == 0
assert len(LinkedList([1])) == 1
assert len(LinkedList([1, 2, 3])) == 3

# head / errors
e = None
try:
    LinkedList().head()
except EmptyListException as ex:
    assert ex.args[0] == "The list is empty."
else:
    raise AssertionError("head() should raise on empty list")

assert LinkedList([1]).head().value() == 1
assert LinkedList([1, 2]).head().value() == 2
assert LinkedList([1]).head().next() is None

# traverse: range(10) -> 9,8,...,0, None
sut = LinkedList(range(10))
current = sut.head()
for i in range(10):
    assert current.value() == 9 - i
    current = current.next()
assert current is None

# push at head
sut = LinkedList([1, 2, 3])
sut.push(4)
assert len(sut) == 4
assert sut.head().value() == 4

sut = LinkedList()
sut.push(5)
assert len(sut) == 1 and sut.head().value() == 5

# pop
sut = LinkedList([3, 4, 5])
assert sut.pop() == 5
assert len(sut) == 2
assert sut.head().value() == 4

sut = LinkedList([1])
assert sut.pop() == 1
try:
    sut.head()
    raise AssertionError("should be empty after pop")
except EmptyListException:
    pass

try:
    LinkedList().pop()
    raise AssertionError("pop on empty should raise")
except EmptyListException as ex:
    assert ex.args[0] == "The list is empty."

# push and pop sequence
sut = LinkedList([1, 2])
sut.push(3)
assert len(sut) == 3
assert sut.pop() == 3
assert sut.pop() == 2
assert sut.pop() == 1
assert len(sut) == 0
sut.push(4)
assert len(sut) == 1 and sut.head().value() == 4

# __iter__ order
assert list(LinkedList()) == []
assert list(LinkedList([1])) == [1]
assert list(LinkedList([1, 2, 3])) == [3, 2, 1]

# reversed
assert list(LinkedList([]).reversed()) == []
assert list(LinkedList([1]).reversed()) == [1]
assert list(LinkedList([1, 2, 3]).reversed()) == [1, 2, 3]

# reversed does not mutate original
sut = LinkedList([1, 2, 3])
sut.reversed()
assert list(sut) == [3, 2, 1]

print("ALL CHECKS PASSED")
