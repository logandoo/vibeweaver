import simple_linked_list as sll

# --- Node ---
n = sll.Node(5)
assert n.value() == 5, 'node value'
assert n.next() is None, 'node next initially None'

# --- LinkedList from range (songs as numbers) ---
ll = sll.LinkedList([1, 2, 3, 4])
assert len(ll) == 4, 'len after init'
# push prepends: head is last pushed
assert ll.head().value() == 4, 'head is most-recent push'

# --- iteration order ---
assert list(ll) == [4, 3, 2, 1], 'iteration head->tail'

# --- push ---
ll.push(9)
assert len(ll) == 5 and ll.head().value() == 9, 'push prepends + increments len'

# --- pop ---
assert ll.pop() == 9, 'pop returns head value'
assert len(ll) == 4, 'pop decrements len'
assert ll.head().value() == 4, 'pop moves head'

# --- empty list ---
empty = sll.LinkedList()
assert len(empty) == 0, 'empty len'
assert list(empty) == [], 'empty iter'

# --- EmptyListException on head/pop of empty ---
try:
    empty.head(); raise SystemExit('FAIL: head on empty did not raise')
except sll.EmptyListException: pass
try:
    empty.pop(); raise SystemExit('FAIL: pop on empty did not raise')
except sll.EmptyListException: pass

# --- reversed (play songs in opposite order) ---
rev = ll.reversed()
assert list(rev) == [1, 2, 3, 4], 'reversed() flips order'
assert list(ll) == [4, 3, 2, 1], 'original unchanged'
assert isinstance(rev, sll.LinkedList), 'reversed returns LinkedList'

# --- None values constructor ---
assert list(sll.LinkedList(None)) == [], 'values=None -> empty'

# --- deep reverse of longer range ---
songs = sll.LinkedList(range(1, 21))
assert list(songs.reversed()) == list(range(1, 21)), 'range reversal'
assert len(songs.reversed()) == 20, 'reversed length preserved'

print('ALL CHECKS PASSED')
"
