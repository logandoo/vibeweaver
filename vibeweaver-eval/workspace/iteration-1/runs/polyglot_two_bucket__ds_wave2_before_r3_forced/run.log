ok = True
for args, exp in cases:
    got = measure(*args)
    status = 'OK' if got == exp else 'FAIL'
    if got != exp: ok = False
    print(f'{status}: measure{args} -> {got} (expected {exp})')
print('ALL PASS' if ok else 'SOME FAILED')
