from bowling import BowlingGame

def game(rolls):
    g = BowlingGame()
    for r in rolls:
        g.roll(r)
    return g.score()

cases = [
    ("all gutter balls (20x0)", [0]*20, 0),
    ("all open frames 9+0 (20x9/0)", [9,0]*10, 90),
    ("one spare then 3: 5,5,3 + rest 0", [5,5,3]+[0]*17, 16),
    ("one strike then 3,4: 10,3,4 + rest 0", [10,3,4]+[0]*16, 24),
    ("prompt example X | 5/ | 9 0", [10,5,5,9,0]+[0]*14, 48),
    ("all spares 5/ (21 rolls)", [5,5]*10+[5], 150),
    ("perfect game 12 strikes", [10]*12, 300),
    ("tenth frame strike + spare fill: ...X 1/", [0,0]*9+[10,1,9], 20),
    ("tenth frame three strikes: ...XXX", [0,0]*9+[10,10,10], 30),
    ("two strikes then 5,3: 10,10,5,3", [10,10,5,3]+[0]*14, 10+10+5+3+ (10+10+5) + (10+5+3) - (10+10+5+3) if False else 0),
]

# explicit two-strike check: frame1=10+10+5=25, frame2=10+5+3=18, frame3=5+3=8 -> 51
assert game([10,10,5,3]+[0]*14) == 51, game([10,10,5,3]+[0]*14)

passed = 0
for name, rolls, expected in cases:
    if name.startswith("two strikes"):
        continue
    got = game(rolls)
    status = "PASS" if got == expected else "FAIL"
    if got == expected:
        passed += 1
    print(f"{status}: {name}: got={got} expected={expected}")
print(f"RESULT: {passed}/{len([c for c in cases if not c[0].startswith('two strikes')])} assertions passed")
print("two-strike lookahead: got", game([10,10,5,3]+[0]*14), "expected 51")
EOF
