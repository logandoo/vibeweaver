import itertools, re, random
from pig_latin import translate as mine

V = 'aeiou'; C = 'bcdfghjklmnpqrstvwxyz'
def ref(word):
    if word[0] in V or word.startswith(('xr','yt')):
        return word + 'ay'
    m = re.match(r'([^aeiou]*qu)(.*)', word)
    if m:
        return m.group(2) + m.group(1) + 'ay'
    m = re.match(r'([^aeiou]+)(.*)', word)
    if m and m.group(2):
        return m.group(2) + m.group(1) + 'ay'
    return word + 'ay'

random.seed(42)
corpus = set()
for clen in range(1, 4):
    for combo in itertools.product(C, repeat=clen):
        corpus.add(''.join(combo) + 'y')
        corpus.add(''.join(combo) + 'qu')
        for vowel in V:
            corpus.add(''.join(combo) + vowel)
corpus |= {'yellow','xenon','qat','liquid','school','quick fast run','squirt','thym','spry','crypt','flyby','cry','glyph'}
mism = []
for w in corpus:
    a, b = mine(w), ref(w)
    if a != b:
        mism.append((w, a, b))
print('corpus size:', len(corpus))
print('mismatches:', len(mism))
for m in mism[:10]:
    print('MISMATCH', m)
raise SystemExit(1 if mism else 0)
