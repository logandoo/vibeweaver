from list_ops import *

# append
assert append([1, 2], [3, 4]) == [1, 2, 3, 4], 'append failed'

# concat
assert concat([[1, 2], [3], [], [4]]) == [1, 2, 3, 4], 'concat failed'

# filter
assert filter(lambda x: x % 2 == 0, [1, 2, 3, 4]) == [2, 4], 'filter failed'

# length
assert length([]) == 0, 'length empty failed'
assert length([1, 2, 3]) == 3, 'length failed'

# map
assert map(lambda x: x * 2, [1, 2, 3]) == [2, 4, 6], 'map failed'

# foldl
assert foldl(lambda acc, x: acc + x, [1, 2, 3, 4], 0) == 10, 'foldl failed'
assert foldl(lambda acc, x: acc * x, [1, 2, 3], 1) == 6, 'foldl prod failed'

# foldr
assert foldr(lambda x, acc: x + acc, [1, 2, 3, 4], 0) == 10, 'foldr failed'
assert foldr(lambda x, acc: x * acc, [1, 2, 3], 1) == 6, 'foldr prod failed'

# reverse
assert reverse([1, 2, 3]) == [3, 2, 1], 'reverse failed'
assert reverse([]) == [], 'reverse empty failed'

# foldr order test: foldr with subtraction should differ from foldl
assert foldl(lambda a, x: a - x, [1, 2, 3], 10) == 4, 'foldl sub failed'  # ((10-1)-2)-3 = 4
assert foldr(lambda x, a: x - a, [1, 2, 3], 10) == -14, 'foldr sub failed'  # 1-(2-(3-10)) = 1-(2-(-7)) = 1-9 = -8 ... let me check
print('foldr sub check:', foldr(lambda x, a: x - a, [1, 2, 3], 10))  # 1 - (2 - (3 - 10)) = 1 - (2 - (-7)) = 1 - 9 = -8

print('All tests passed!')
"

