check("filter non-empty", list_ops_filter(lambda x: x % 2 == 1, [1, 2, 3, 5]), [1, 3, 5])
check("length empty", length([]), 0)
check("length non-empty", length([1, 2, 3, 4]), 4)
check("map empty", list_ops_map(lambda x: x + 1, []), [])
check("map non-empty", list_ops_map(lambda x: x + 1, [1, 3, 5, 7]), [2, 4, 6, 8])
check("foldl empty", foldl(lambda acc, el: el * acc, [], 2), 2)
check("foldl dir-indep", foldl(lambda acc, el: el + acc, [1, 2, 3, 4], 5), 15)
check("foldl dir-dep", foldl(lambda acc, el: el / acc, [1, 2, 3, 4], 24), 64)
check("foldr empty", foldr(lambda acc, el: el * acc, [], 2), 2)
check("foldr dir-indep", foldr(lambda acc, el: el + acc, [1, 2, 3, 4], 5), 15)
check("foldr dir-dep", foldr(lambda acc, el: el / acc, [1, 2, 3, 4], 24), 9)
check("reverse empty", reverse([]), [])
check("reverse non-empty", reverse([1, 3, 5, 7]), [7, 5, 3, 1])
check("reverse nested", reverse([[1, 2], [3], [], [4, 5, 6]]), [[4, 5, 6], [], [3], [1, 2]])
check("foldr add string", foldr(lambda acc, el: el + acc, ["e","x","e","r","c","i","s","m"], "!"), "exercism!")
