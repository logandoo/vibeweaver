from transpose import transpose

# Example 1: ABC/DEF -> AD/BE/CF
result = transpose('ABC\nDEF')
print('Test 1:')
print(repr(result))
assert result == 'AD\nBE\nCF', f'Expected AD/BE/CF, got {repr(result)}'
print('PASS')

# Example 2: ABC/DE -> AD/BE/C (left pad, no right pad)
result = transpose('ABC\nDE')
print('\nTest 2:')
print(repr(result))
assert result == 'AD\nBE\nC', f'Expected AD/BE/C, got {repr(result)}'
print('PASS')

# Example 3: AB/DEF -> AD/BE/ F (pad left with space)
result = transpose('AB\nDEF')
print('\nTest 3:')
print(repr(result))
assert result == 'AD\nBE\n F', f'Expected AD/BE/ F, got {repr(result)}'
print('PASS')

# Edge cases
