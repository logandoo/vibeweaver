from collections import deque

bucket_one, bucket_two, goal, start_bucket = 7, 11, 8, 'one'
forbidden = (0, bucket_two)
start = (bucket_one, 0)

# BFS with level tracking
visited = {start}
queue = deque([(start, 1)])
found_at = {}

while queue:
    (b1, b2), actions = queue.popleft()
    
    if b1 == goal:
        print(f'Goal in bucket_one at actions={actions}: ({b1}, {b2})')
        break
    if b2 == goal:
        print(f'Goal in bucket_two at actions={actions}: ({b1}, {b2})')
        break
    
    next_states = []
    pour = min(b1, bucket_two - b2)
    next_states.append((b1 - pour, b2 + pour))
    pour = min(b2, bucket_one - b1)
    next_states.append((b1 + pour, b2 - pour))
    next_states.append((0, b2))
    next_states.append((b1, 0))
    next_states.append((bucket_one, b2))
    next_states.append((b1, bucket_two))
    
    for nb1, nb2 in next_states:
        if (nb1, nb2) == forbidden or (nb1, nb2) in visited:
