import unittest
from bowling import BowlingGame

class BowlingTest(unittest.TestCase):
    def roll_new_game(self, rolls):
        game = BowlingGame()
        for roll in rolls:
            game.roll(roll)
        return game

    def test_all_zeros(self):
        self.assertEqual(self.roll_new_game([0]*20).score(), 0)
    def test_no_strikes_or_spares(self):
        self.assertEqual(self.roll_new_game([3,6]*10).score(), 90)
    def test_spare_followed_by_zeros(self):
        self.assertEqual(self.roll_new_game([6,4]+[0]*18).score(), 10)
    def test_roll_after_spare_counted_twice(self):
        self.assertEqual(self.roll_new_game([6,4,3]+[0]*17).score(), 16)
    def test_consecutive_spares(self):
        self.assertEqual(self.roll_new_game([5,5,3,7,4]+[0]*15).score(), 31)
    def test_spare_in_last_frame_bonus_counted_once(self):
        self.assertEqual(self.roll_new_game([0]*18+[7,3,7]).score(), 17)
    def test_strike_earns_ten_in_single_roll_frame(self):
        self.assertEqual(self.roll_new_game([10]+[0]*18).score(), 10)
    def test_two_rolls_after_strike_counted_twice(self):
        self.assertEqual(self.roll_new_game([10,5,3]+[0]*16).score(), 26)
    def test_consecutive_strikes_each_get_two_roll_bonus(self):
        self.assertEqual(self.roll_new_game([10,10,10,5,3]+[0]*12).score(), 81)
    def test_strike_in_last_frame_bonus_counted_once(self):
        self.assertEqual(self.roll_new_game([0]*18+[10,7,1]).score(), 18)
    def test_spare_with_two_roll_bonus_no_bonus_roll(self):
        self.assertEqual(self.roll_new_game([0]*18+[10,7,3]).score(), 20)
    def test_strikes_with_two_roll_bonus_no_bonus_rolls(self):
        self.assertEqual(self.roll_new_game([0]*18+[10,10,10]).score(), 30)
    def test_last_two_strikes_then_non_strike_bonus(self):
        self.assertEqual(self.roll_new_game([0]*16+[10,10,0,1]).score(), 31)
    def test_spare_in_last_frame_then_strike_bonus(self):
        self.assertEqual(self.roll_new_game([0]*18+[7,3,10]).score(), 20)
    def test_perfect_game(self):
        self.assertEqual(self.roll_new_game([10]*12).score(), 300)
    def test_two_bonus_rolls_after_strike_can_exceed_ten_if_strike(self):
        self.assertEqual(self.roll_new_game([0]*18+[10,10,6]).score(), 26)

    def test_negative_roll(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([]).roll(-1)
    def test_roll_more_than_ten(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([]).roll(11)
    def test_two_rolls_in_frame_more_than_ten(self):
        g = self.roll_new_game([5])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(6)
    def test_bonus_after_strike_more_than_ten(self):
        g = self.roll_new_game([0]*18+[10])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(11)
    def test_two_bonus_after_strike_sum_more_than_ten(self):
        g = self.roll_new_game([0]*18+[10,5])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(6)
    def test_second_bonus_strike_when_first_not(self):
        g = self.roll_new_game([0]*18+[10,6])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(10)
    def test_second_bonus_after_strike_more_than_ten(self):
        g = self.roll_new_game([0]*18+[10,10])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(11)
    def test_unstarted_game_scored(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([]).score()
    def test_incomplete_game_scored(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([0,0]).score()
    def test_cannot_roll_after_ten_frames(self):
        g = self.roll_new_game([0]*20)
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(0)
    def test_strike_bonus_must_be_rolled_before_score(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([0]*18+[10]).score()
    def test_both_strike_bonuses_before_score(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([0]*18+[10,10]).score()
    def test_spare_bonus_before_score(self):
        with self.assertRaisesRegex(Exception, r".+"):
            self.roll_new_game([0]*18+[7,3]).score()
    def test_cannot_roll_after_spare_bonus(self):
        g = self.roll_new_game([0]*18+[7,3,2])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(2)
    def test_cannot_roll_after_strike_bonuses(self):
        g = self.roll_new_game([0]*18+[10,3,2])
        with self.assertRaisesRegex(Exception, r".+"):
            g.roll(2)

if __name__ == "__main__":
    unittest.main(verbosity=2)
