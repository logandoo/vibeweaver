import variable_length_quantity as v
cases = [
    (0x00000000, [0x00]),
    (0x00000040, [0x40]),
    (0x0000007F, [0x7F]),
    (0x00000080, [0x81, 0x00]),
    (0x00002000, [0xC0, 0x00]),
    (0x00003FFF, [0xFF, 0x7F]),
    (0x00004000, [0x81, 0x80, 0x00]),
    (0x00100000, [0xC0, 0x80, 0x00]),
    (0x001FFFFF, [0xFF, 0xFF, 0x7F]),
    (0x00200000, [0x81, 0x80, 0x80, 0x00]),
    (0x08000000, [0xC0, 0x80, 0x80, 0x00]),
    (0x0FFFFFFF, [0xFF, 0xFF, 0xFF, 0x7F]),
]
ok = True
for num, expected in cases:
    enc = v.encode([num]); dec = v.decode(enc)
    if not (enc == expected and dec == [num]): ok = False; print('FAIL', hex(num))
# edges
assert v.encode([]) == [] and v.decode([]) == []
assert v.encode([0, 0]) == [0, 0]
assert v.encode([0xFFFFFFFF]) == [0x8F, 0xFF, 0xFF, 0xFF, 0x7F]
assert v.decode([0x8F, 0xFF, 0xFF, 0xFF, 0x7F]) == [0xFFFFFFFF]
for bad in [lambda: v.decode([0x80]), lambda: v.decode([0x41, 0x81])]:
    try: bad(); ok=False; print('FAIL no error')
    except ValueError: pass
# multi-value stream
