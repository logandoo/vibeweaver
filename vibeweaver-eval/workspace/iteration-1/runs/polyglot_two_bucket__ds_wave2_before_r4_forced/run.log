+def optimal_outcomes(cap_one, cap_two, goal, start):
+    """Independent minimality oracle returning the FULL set of optimal
+    outcomes: (min_actions, goal_bucket, other) triples such that a legal
+    action sequence of exactly min_actions steps reaches `goal` in
+    goal_bucket with `other` in the remaining bucket. Raises ValueError if
+    unreachable. Set-based so ambiguous instances (multiple optimal goal
+    states) are accepted exactly — no arbitrary tie-break."""
+    forbidden, initial = _forbidden_and_initial(cap_one, cap_two, start)
+    if initial == forbidden:
+        raise ValueError("Goal is not reachable")
+    if initial[0] == goal or initial[1] == goal:
+        gb = "one" if initial[0] == goal else "two"
+        other = initial[1] if initial[0] == goal else initial[0]
+        return {(1, gb, other)}
+
+    states = [(x, y) for x in range(cap_one + 1) for y in range(cap_two + 1)]
+    INF = float("inf")
+    dist = {s: INF for s in states}
+    dist[initial] = 1
+
+    def neighbors(s):
+        a, b = s
+        out = []
+        for cand in ((cap_one, b), (a, cap_two), (0, b), (a, 0),
+                     (a - min(a, cap_two - b), b + min(a, cap_two - b)),
+                     (a + min(b, cap_one - a), b - min(b, cap_one - a))):
+            if cand != s and cand != forbidden:
+                out.append(cand)
+        return out
+
+    changed = True
+    while changed:
+        changed = False
+        for s in states:
+            if dist[s] == INF:
+                continue
+            for nxt in neighbors(s):
+                if dist[s] + 1 < dist[nxt]:
+                    dist[nxt] = dist[s] + 1
+                    changed = True
+
+    outcomes = set()
+    min_actions = None
+    for s in states:
+        if s == forbidden or dist[s] == INF:
+            continue
+        if s[0] == goal or s[1] == goal:
+            if min_actions is None or dist[s] < min_actions:
+                min_actions = dist[s]
+    if min_actions is None:
+        raise ValueError("Goal is not reachable")
+    for s in states:
+        if s == forbidden or dist[s] != min_actions:
+            continue
+        if s[0] == goal:
+            outcomes.add((int(min_actions), "one", s[1]))
+        if s[1] == goal:
+            outcomes.add((int(min_actions), "two", s[0]))
+    return outcomes
+
+
