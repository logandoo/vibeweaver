from variable_length_quantity import encode, decode

cases = {
    0x0: [0x00],
    0x40: [0x40],
    0x7F: [0x7F],
    0x80: [0x81, 0x00],
    0x2000: [0xC0, 0x00],
    0x3FFF: [0xFF, 0x7F],
    0x4000: [0x81, 0x80, 0x00],
    0x100000: [0xC0, 0x80, 0x00],
    0x1FFFFF: [0xFF, 0xFF, 0x7F],
    0x200000: [0x81, 0x80, 0x80, 0x00],
    0x8000000: [0xC0, 0x80, 0x80, 0x00],
    0xFFFFFFF: [0xFF, 0xFF, 0xFF, 0x7F],
}

for n, expected in cases.items():
    got = encode([n])
    assert got == expected, f"encode({n:#x}) = {got}, expected {expected}"
    back = decode(expected)
    assert back == [n], f"decode({expected}) = {back}, expected {[n]}"

assert encode([]) == []
assert decode([]) == []
assert encode([0x7F, 0x2000]) == [0x7F, 0xC0, 0x00]
assert decode([0x7F, 0xC0, 0x00]) == [0x7F, 0x2000]
assert encode([0xFFFFFFFF]) == [0x8F, 0xFF, 0xFF, 0xFF, 0x7F]
assert decode([0x8F, 0xFF, 0xFF, 0xFF, 0x7F]) == [0xFFFFFFFF]

for bad in ([0xFF], [0x80], [0xC0], [0x81, 0x80]):
    try:
        decode(bad)
    except ValueError:
        pass
    else:
        raise AssertionError(f"decode({bad}) should raise ValueError")

for n in range(0, 1 << 20):
    assert decode(encode([n])) == [n], n

print("ALL CHECKS PASSED")
