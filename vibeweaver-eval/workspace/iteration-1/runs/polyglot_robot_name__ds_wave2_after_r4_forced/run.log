import re, random
from robot_name import Robot

name_re = r'^[A-Z]{2}\d{3}$'
results = []

# 1. format
r = Robot()
ok = re.match(name_re, r.name) is not None
results.append(("c1 format regex", ok, r.name))

# 2. sticks
r = Robot()
_ = r.name
results.append(("c2 name sticks", r.name == r.name, r.name))

# 3. different robots
results.append(("c3 different robots", Robot().name != Robot().name, f"{Robot().name} vs {Robot().name}"))

# 4. reset wipes + new valid name
r = Robot(); n1 = r.name; r.reset(); n2 = r.name
results.append(("c4 reset new valid", (n1 != n2) and re.match(name_re, n2) is not None, f"{n1} -> {n2}"))

# 5. canonical seeded reset test
seed = "Totally random."
random.seed(seed)
robot = Robot(); name = robot.name
random.seed(seed)
robot.reset(); name2 = robot.name
results.append(("c5 seeded reset differs", name != name2, f"{name} vs {name2}"))

# 6. uniqueness among N robots
names = [Robot().name for _ in range(100)]
results.append(("c6 100 robots unique", len(names) == len(set(names)), f"n={len(names)} unique={len(set(names))}"))

# 7. import/syntax clean (implied by this script running)
results.append(("c7 import clean", True, "script executed"))

all_pass = all(ok for _, ok, _ in results)
for label, ok, detail in results:
    print(f"{'PASS' if ok else 'FAIL'} | {label} | {detail}")
print("ALL PASS" if all_pass else "SOME FAILED")
