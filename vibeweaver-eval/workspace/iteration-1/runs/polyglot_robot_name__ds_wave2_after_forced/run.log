import re
import robot_name

results = []

def check(criterion, ok, detail):
    results.append((criterion, ok, detail))
    print(f"criterion {criterion}: {'PASS' if ok else 'FAIL'} -- {detail}")

import importlib, sys
importlib.reload(robot_name)
importlib.reload(sys.modules[robot_name.__name__])

check(1, hasattr(robot_name, "Robot") and callable(robot_name.Robot),
      "robot_name imports and Robot() constructible")
r1 = robot_name.Robot()
check(1, True, "Robot() constructed")
check(2, bool(re.fullmatch(r"[A-Z]{2}[0-9]{3}", r1.name)), f"name matches ^[A-Z]{{2}}[0-9]{{3}}$ (got {r1.name})")
stable = r1.name
check(3, all(r1.name == stable for _ in range(5)), "name stable across repeated reads")
r2 = robot_name.Robot()
check(4, r1.name != r2.name, f"distinct instances differ ({r1.name} vs {r2.name})")
old = r1.name
r1.reset()
check(5, r1.name != old and bool(re.fullmatch(r"[A-Z]{2}[0-9]{3}", r1.name)),
      f"reset yields new valid name different from previous ({old} -> {r1.name})")

robots = [robot_name.Robot() for _ in range(500)]
names = [rb.name for rb in robots]
check(6, len(set(names)) == 500, "500 robots all have unique names")
prefixes = {n[:2] for n in names}
suffixes = {n[2:] for n in names}
check(7, len(prefixes) >= 20, f"names non-sequential: {len(prefixes)} distinct 2-letter prefixes, {len(suffixes)} distinct digit suffixes")

all_names = set(names)
extra = [robot_name.Robot() for _ in range(3000)]
extra_names = {rb.name for rb in extra}
print(f"extended sweep: 3000 more robots unique = {len(extra_names) == 3000}")
res_ok = True
for _ in range(200):
    prev = r2.name
    r2.reset()
    if not (re.fullmatch(r"[A-Z]{2}[0-9]{3}", r2.name) and r2.name != prev):
        res_ok = False
print(f"extended sweep: 200 sequential resets all valid + different-from-prev = {res_ok}")
all_names |= extra_names
print(f"extended sweep: {len(all_names)} total names all unique = {len(all_names) == 500 + 3000}")

npass = sum(1 for _, ok, _ in results if ok)
print(f"SUMMARY: {npass}/7 passed")
sys.exit(0 if npass == 7 else 1)
