class School:
    def __init__(self):
        self._roster = {}
        self._added = []

    def add_student(self, name, grade):
        if name in self._enrolled():
            self._added.append(False)
            return
        self._roster.setdefault(grade, []).append(name)
        self._added.append(True)

    def roster(self):
        students = []
        for grade in sorted(self._roster):
            students.extend(sorted(self._roster[grade]))
        return students

    def grade(self, grade_number):
        return sorted(self._roster.get(grade_number, []))

    def added(self):
        return list(self._added)

    def _enrolled(self):
        return {name for students in self._roster.values() for name in students}
