# Rule 1: vowel starts, xr, yt
assert translate('apple') == 'appleay', f'apple: {translate(\"apple\")}'
assert translate('xray') == 'xrayay', f'xray: {translate(\"xray\")}'
assert translate('yttria') == 'yttriaay', f'yttria: {translate(\"yttria\")}'

# Rule 2: consonant clusters
assert translate('pig') == 'igpay', f'pig: {translate(\"pig\")}'
assert translate('chair') == 'airchay', f'chair: {translate(\"chair\")}'
assert translate('thrush') == 'ushthray', f'thrush: {translate(\"thrush\")}'

# Rule 3: qu handling
assert translate('quick') == 'ickquay', f'quick: {translate(\"quick\")}'
assert translate('square') == 'aresquay', f'square: {translate(\"square\")}'

# Rule 4: y after consonants
assert translate('my') == 'ymay', f'my: {translate(\"my\")}'
assert translate('rhythm') == 'ythmrhay', f'rhythm: {translate(\"rhythm\")}'

# Multi-word
