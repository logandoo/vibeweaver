from collections import Counter
from transpose import transpose

cases = {
    "": "",
    "A1": "A\n1",
    "A\n1": "A1",
    "ABC\n123": "A1\nB2\nC3",
    "ABC\nDE": "AD\nBE\nC",
    "AB\nDEF": "AD\nBE\n F",
    "Single line.": "S\ni\nn\ng\nl\ne\n \nl\ni\nn\ne\n.",
    "The fourth line.\nThe fifth line.": "TT\nhh\nee\n  \nff\noi\nuf\nrt\nth\nh \n l\nli\nin\nne\ne.\n.",
}
for text, expected in cases.items():
    got = transpose(text)
    assert got == expected, f"FAIL {text!r}: {got!r} != {expected!r}"

# character-preservation: every non-space input char survives with same count
for text in cases:
    src = Counter(c for c in text if c != "\n" and c != " ")
    out = Counter(c for c in transpose(text) if c != "\n" and c != " ")
    assert src == out, f"char loss for {text!r}: {src} vs {out}"

# trailing real spaces preserved (not stripped as padding)
assert transpose("ABC\nDE ") == "AD\nBE\nC ", transpose("ABC\nDE ")
assert transpose("The fourth line.\nThe fifth line.").split("\n")[9] == "h "

print("manual scenario: OK (9 explicit cases + char-preservation + trailing-space checks)")
PY
