from phone_number import PhoneNumber

def run(label, fn):
    try:
        result = fn()
        print(f"PASS  {label} -> {result!r}  (expected)")
    except AssertionError:
        print(f"FAIL  {label} -> {result!r}")
    except ValueError as e:
        print(f"PASS  {label} -> ValueError: {e}  (expected)")

def expect_number(inp, out):
    got = PhoneNumber(inp).number
    assert got == out, f"{inp}: got {got!r} expected {out!r}"
    print(f"PASS  {inp!r}.number == {out!r}")

def expect_error(inp, msg):
    try:
        PhoneNumber(inp)
        print(f"FAIL  {inp!r} did not raise")
    except ValueError as e:
        assert e.args[0] == msg, f"{inp}: got {e.args[0]!r} expected {msg!r}"
