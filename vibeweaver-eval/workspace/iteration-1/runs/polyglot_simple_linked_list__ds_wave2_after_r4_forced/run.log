from simple_linked_list import LinkedList, EmptyListException

# canonical exercism simple-linked-list cases
# empty list
assert len(LinkedList()) == 0
assert len(LinkedList([])) == 0
try:
    LinkedList().head(); assert False
except EmptyListException:
    pass
try:
    LinkedList().pop(); assert False
except EmptyListException:
    pass

# singleton
sut = LinkedList([1])
assert len(sut) == 1
assert sut.head().value() == 1

# insertion / push
sut = LinkedList()
sut.push(1)
assert len(sut) == 1
assert sut.head().value() == 1
sut.push(2)
assert len(sut) == 2
assert sut.head().value() == 2
assert sut.head().next().value() == 1

# pop
sut = LinkedList([1, 2])
assert sut.pop() == 2
assert len(sut) == 1
assert sut.head().value() == 1
assert sut.pop() == 1

# iteration (head-first => reverse of insertion order)
sut = LinkedList([1, 2, 3])
assert list(sut) == [3, 2, 1]

# reversed
sut = LinkedList([1, 2, 3, 4])
assert list(sut) == [4, 3, 2, 1]
assert list(sut.reversed()) == [1, 2, 3, 4]
assert len(sut.reversed()) == 4

# reversed is a fresh LinkedList, original unchanged
original = list(sut)
assert list(sut) == original

# Node API
n = sut.head()
assert n.value() == 4
assert n.next().value() == 3

print("ALL ASSERTIONS PASSED")
EOF
