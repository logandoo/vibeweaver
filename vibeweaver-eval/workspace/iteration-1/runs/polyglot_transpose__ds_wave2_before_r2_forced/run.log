import random
from collections import Counter

def transpose(text):
    lines = text.split("\n")
    max_len = max((len(line) for line in lines), default=0)
    out = []
    for i in range(max_len):
        col = [line[i] if i < len(line) else " " for line in lines]
        keep = len(lines)
        while keep and len(lines[keep - 1]) <= i:
            keep -= 1
        out.append("".join(col[:keep]))
    return "\n".join(out)

def chars(s):
    return Counter(c for c in s if c != " " and c != "\n")

rng = random.Random(42)
fails = 0
for _ in range(5000):
    n = rng.randint(0, 6)
    rows = ["".join(rng.choice("AB C ") for _ in range(rng.randint(0, 5))) for _ in range(n)]
    src = "\n".join(rows)
    out = transpose(src)
    o_rows = out.split("\n") if out else []
    if chars(src) != chars(out):
        fails += 1; print("FAIL chars", repr(src), repr(out)); continue
    m = max((len(r) for r in rows), default=0)
    if len(o_rows) != m:
        fails += 1; print("FAIL rows", repr(src), repr(out)); continue
    if all(len(r) == m for r in rows) and transpose(out) != src:
        fails += 1; print("FAIL invol", repr(src), repr(out))
print("fixed random property check fails:", fails)
