import random, string

def transpose(text):
    lines = text.split("\n")
    max_len = max((len(line) for line in lines), default=0)
    out = []
    for i in range(max_len):
        col = [line[i] if i < len(line) else " " for line in lines]
        keep = len(lines)
        while keep and len(lines[keep - 1]) <= i:
            keep -= 1
        out.append("".join(col[:keep]))
    return "\n".join(out)

rng = random.Random(42)
fails = 0
for _ in range(2000):
    n = rng.randint(0, 6)
    rows = []
    for _ in range(n):
        ln = rng.randint(0, 5)
        rows.append("".join(rng.choice("AB C ") for _ in range(ln)))
    src = "\n".join(rows)
    out = transpose(src)
    o_rows = out.split("\n") if out else []
    # 1) every non-space input char survives (with multiplicity)
    if {c for c in src if c != " "} != {c for c in out if c != " "}:
        fails += 1; print("FAIL chars", repr(src), repr(out)); continue
    # 2) output rows == max input row length (0 rows for empty)
    m = max((len(r) for r in rows), default=0)
    if len(o_rows) != m:
        fails += 1; print("FAIL rows", repr(src), repr(out)); continue
    # 3) transpose(transpose) recovers input when input has no trailing spaces per row
    #    (padding-only info is lossy by spec, so only check full-rectangle inputs)
    if all(len(r) == m for r in rows):
        if transpose(out) != src:
            fails += 1; print("FAIL involution", repr(src), repr(out), repr(transpose(out)))
print("random property check fails:", fails)
