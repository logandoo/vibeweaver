from transpose import transpose

def check(name, lines, expected):
    text = "\n".join(lines)
    got = transpose(text)
    got_lines = got.split("\n") if got else []
    ok = got_lines == expected
    print(f"{'PASS' if ok else 'FAIL'}  {name}")
    if not ok:
        print(f"  expected: {expected}")
        print(f"  got:      {got_lines}")
    return ok

cases = [
    ("empty string", [], []),
    ("two characters in a row", ["A1"], ["A","1"]),
    ("two characters in a column", ["A","1"], ["A1"]),
    ("simple", ["ABC","123"], ["A1","B2","C3"]),
    ("single line", ["Single line."], ["S","i","n","g","l","e"," ","l","i","n","e","."]),
    ("first line longer than second line", ["The fourth line.","The fifth line."],
        ["TT","hh","ee","  ","ff","oi","uf","rt","th","h "," l","li","in","ne","e.","."]),
    ("second line longer than first line", ["The first line.","The second line."],
        ["TT","hh","ee","  ","fs","ie","rc","so","tn"," d","l ","il","ni","en",".e"," ."]),
    ("mixed line length", ["The longest line.","A long line.","A longer line.","A line."],
        ["TAAA","h   ","elll"," ooi","lnnn","ogge","n e.","glr","ei ","snl","tei"," .n","l e","i .","n","e","."]),
    ("square", ["HEART","EMBER","ABUSE","RESIN","TREND"],
        ["HEART","EMBER","ABUSE","RESIN","TREND"]),
    ("rectangle", ["FRACTURE","OUTLINED","BLOOMING","SEPTETTE"],
        ["FOBS","RULE","ATOP","CLOT","TIME","UNIT","RENT","EDGE"]),
    ("triangle", ["T","EE","AAA","SSSS","EEEEE","RRRRRR"],
        ["TEASER"," EASER","  ASER","   SER","    ER","     R"]),
    ("jagged triangle", ["11","2","3333","444","555555","66666"],
        ["123456","1 3456","  3456","  3 56","    56","    5"]),
]

all_ok = True
for name, lines, expected in cases:
    all_ok &= check(name, lines, expected)
print(f"\n{sum(1 for _ in range(0))} -> overall: {'ALL PASS' if all_ok else 'SOME FAILED'}")
