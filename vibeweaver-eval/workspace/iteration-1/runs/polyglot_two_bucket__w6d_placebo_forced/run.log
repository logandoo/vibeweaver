python3 -c "
import json
from two_bucket import measure
data = json.load(open('/var/folders/8z/h73xmj297g1995r1d9q6dc2r0000gn/T/opencode/two_bucket_canonical.json'))
fails = 0
for case in data['cases']:
    i = case['input']
    exp = case['expected']
    try:
        got = measure(i['bucketOne'], i['bucketTwo'], i['goal'], i['startBucket'])
        ok = (got[0] == exp['moves'] and got[1] == exp['goalBucket'] and got[2] == exp['otherBucket'])
    except ValueError:
        ok = exp.get('error') == 'impossible'
        got = 'ValueError'
    status = 'OK' if ok else 'FAIL'
    if not ok:
        fails += 1
    print(status, i, '->', got)
print('FAILURES:', fails)
"
