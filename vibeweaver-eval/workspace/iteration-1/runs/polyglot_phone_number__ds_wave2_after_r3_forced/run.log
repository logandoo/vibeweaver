  ```python
  import re
  from string import punctuation

  class PhoneNumber:
      def __init__(self, number):
          self.number = self._clean(number)
          self.area_code = self.number[:3]
      def pretty(self):
          return f"({self.area_code})-{self.number[3:6]}-{self.number[6:]}"
      def _clean(self, number):
          preprocess = re.sub(r"[\s\-().+]", "", number)
          # letters → "letters not permitted"; then punctuation → "punctuations not permitted";
          # <10 → "must not be fewer than 10 digits"; >11 → "must not be greater than 11 digits";
          # 11 digits not starting with "1" → "11 digits must start with 1", else strip "1";
          # preprocess[0] in "01" → area code errors; preprocess[3] in "01" → exchange code errors
  ```

