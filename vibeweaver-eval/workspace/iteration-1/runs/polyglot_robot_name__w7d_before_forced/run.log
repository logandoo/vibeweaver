[0m$ [0mpython3 -c '
import re, random
from robot_name import Robot

pattern = re.compile(r"^[A-Z]{2}[0-9]{3}$")

# 1. lazy generation + pattern
r = Robot()
assert r.name is None or True
n = r.name
assert pattern.match(n), n
# 2. cached (stable) name
assert r.name == n
# 3. reset produces a valid, different name
old = n
r.reset()
new = r.name
assert pattern.match(new), new
assert new != old, (old, new)
# 4. uniqueness across many robots
robots = [Robot() for _ in range(2000)]
names = [rb.name for rb in robots]
assert len(names) == len(set(names)), "collision detected"
# 5. reset frees name -> uniqueness of *current* names holds
rb = robots[0]
before = rb.name
rb.reset()
current = {x.name for x in robots}
assert len(current) == len(robots), "uniqueness broken after reset"
# 6. reset before first use is a no-op
r2 = Robot(); r2.reset(); assert pattern.match(r2.name)
print("ALL CHECKS PASSED")
print("sample names:", names[:5])
'
ALL CHECKS PASSED
sample names: ['XV917', 'HN376', 'RE894', 'LU401', 'NY196']
