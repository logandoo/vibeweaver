from variable_length_quantity import encode, decode

cases = [
    ([0x00], [0x00]),
    ([0x40], [0x40]),
    ([0x7F], [0x7F]),
    ([0x80], [0x81, 0x00]),
    ([0x2000], [0xC0, 0x00]),
    ([0x3FFF], [0xFF, 0x7F]),
    ([0x4000], [0x81, 0x80, 0x00]),
    ([0x100000], [0xC0, 0x80, 0x00]),
    ([0x1FFFFF], [0xFF, 0xFF, 0x7F]),
    ([0x200000], [0x81, 0x80, 0x80, 0x00]),
    ([0x8000000], [0xC0, 0x80, 0x80, 0x00]),
    ([0x0FFFFFFF], [0xFF, 0xFF, 0xFF, 0x7F]),
    ([0xFF000000], [0x8F, 0xF8, 0x80, 0x80, 0x00]),
    ([0xFFFFFFFF], [0x8F, 0xFF, 0xFF, 0xFF, 0x7F]),
    ([0x2000, 0x3FFF], [0xC0, 0x00, 0xFF, 0x7F]),
]
ok = 0
for numbers, expected in cases:
    got = encode(numbers)
    assert got == expected, ('encode', numbers, got, expected)
    assert decode(expected) == numbers, ('decode', expected, decode(expected), numbers)
    ok += 1

assert decode([]) == []
assert encode([]) == []
try:
    decode([0x81])
    raise AssertionError('expected ValueError')
except ValueError as e:
    assert str(e) == 'incomplete sequence', str(e)
try:
    decode([0xC0])
    raise AssertionError('expected ValueError')
except ValueError as e:
    assert str(e) == 'incomplete sequence', str(e)
try:
    decode([0x80])
    raise AssertionError('expected ValueError')
except ValueError as e:
    assert str(e) == 'incomplete sequence', str(e)

for n in range(0, 0x100000, 7919):
    assert decode(encode([n])) == [n], n
for n in (0x0FFFFFFF, 0xFFFFFFFF, 0x80000000, 0x12345678):
    assert decode(encode([n])) == [n], n

print('ALL PASS:', ok, 'explicit cases + edge/error/roundtrip')
" 2>&1; echo "exit=$?"
