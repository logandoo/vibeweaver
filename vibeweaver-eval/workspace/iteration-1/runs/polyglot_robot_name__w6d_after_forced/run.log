[0m$ [0mpython3 - <<'PY'
import re, random, sys
from robot_name import Robot

fails = []
name_re = r'^[A-Z]{2}\d{3}$'

# test_has_name
if not re.match(name_re, Robot().name): fails.append("has_name")

# test_name_sticks
r = Robot(); r.name
if r.name != r.name: fails.append("name_sticks")

# test_different_robots_have_different_names
if Robot().name == Robot().name: fails.append("different_robots")

# test_reset_name (canonical seed test)
seed = "Totally random."
random.seed(seed)
robot = Robot(); name = robot.name
random.seed(seed)
robot.reset(); name2 = robot.name
if name == name2: fails.append("reset_name")
if not re.match(name_re, name2): fails.append("reset_name_format")

# stress: uniqueness across many robots, reset, and freed-name non-reuse
seen = set()
robots = [Robot() for _ in range(5000)]
for rb in robots:
    n = rb.name
    if not re.match(name_re, n): fails.append("stress_format"); break
    if n in seen: fails.append("stress_duplicate"); break
    seen.add(n)
for rb in robots[:1000]:
    rb.reset()
    n = rb.name
    if n in seen: fails.append("reset_reused_existing"); break
    seen.add(n)

# reset on never-named robot
r3 = Robot(); r3.reset(); n3 = r3.name
if not re.match(name_re, n3): fails.append("reset_unnamed")

print("total unique names generated:", len(seen))
if fails:
    print("FAILED:", fails); sys.exit(1)
print("ALL CHECKS PASSED")
