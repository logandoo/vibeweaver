assert lo.foldr(lambda x, acc: acc + x, [1, 2, 3, 4], 5) == 15
assert lo.foldr(lambda x, acc: x - acc, [1, 2, 3], 0) == 2
assert lo.reverse([1, 2, 3]) == [3, 2, 1]
