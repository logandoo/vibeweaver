import re, random
from robot_name import Robot

pattern = re.compile(r"^[A-Z]{2}[0-9]{3}$")
failures = []

def check(cond, label):
    status = "PASS" if cond else "FAIL"
    print(f"[{status}] {label}")
    if not cond:
        failures.append(label)

r = Robot()
n1 = r.name
check(pattern.match(n1) is not None, f"iter1 name format regex: {n1} matches [A-Z]{{2}}[0-9]{{3}}")
check(r.name == n1, "iter1 name stable on repeat access")
check(len(r.name) == 5, "iter1 name length == 5")

r2 = Robot()
check(r2.name != r.name, f"iter1 two different robots get different names ({r.name} vs {r2.name})")
check(pattern.match(r2.name) is not None, f"iter1 robot2 format: {r2.name}")

old = r.name
r.reset()
check(r.name != old, f"iter2 reset gives new name ({old} -> {r.name})")
check(pattern.match(r.name) is not None, f"iter2 reset name format: {r.name}")
check(r.name != r2.name, "iter2 reset name differs from other robot")

names = set()
ok = True
for _ in range(1000):
    name = Robot().name
    if name in names:
        ok = False
    names.add(name)
check(ok, "iter2 1000 robots all unique names")
check(len(names) == 1000, "iter2 uniqueness set size == 1000")

print(f"\nTOTAL: {len(failures)} failures")
raise SystemExit(1 if failures else 0)
