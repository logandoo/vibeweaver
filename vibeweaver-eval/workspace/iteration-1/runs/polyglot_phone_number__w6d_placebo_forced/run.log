Small, well-defined task: implement the NANP phone number cleaner. The canonical Exercism interface expects `.number`, `.area_code`, and `.pretty()` with `ValueError` on invalid input. Let me implement it.
[0m$ [0mpython3 -c '
from phone_number import PhoneNumber

# valid cleanings
for raw, expected in [
    ("+1 (613)-995-0253", "6139950253"),
    ("613-995-0253", "6139950253"),
    ("1 613 995 0253", "6139950253"),
    ("613.995.0253", "6139950253"),
    ("(223) 456-7890", "2234567890"),
    ("223 456   7890   ", "2234567890"),
    ("12234567890", "2234567890"),
    ("+1 (223) 456-7890", "2234567890"),
]:
    got = PhoneNumber(raw).number
    assert got == expected, (raw, got, expected)

assert PhoneNumber("(223) 456-7890").area_code == "223"
assert PhoneNumber("2234567890").pretty() == "(223) 456-7890"

# invalid cases
for raw in [
    "123456789",
    "22234567890",
    "321234567890",
    "123-abc-7890",
    "123-@:!-7890",
    "(023) 456-7890",
    "(123) 456-7890",
    "(223) 056-7890",
    "(223) 156-7890",
    "1 (023) 456-7890",
    "1 (223) 156-7890",
]:
    try:
        PhoneNumber(raw)
    except ValueError:
        pass
    else:
        raise AssertionError("expected ValueError for " + raw)

print("all checks passed")
'
