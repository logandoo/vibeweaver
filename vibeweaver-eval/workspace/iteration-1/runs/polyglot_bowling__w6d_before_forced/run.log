from bowling import BowlingGame

def play(rolls):
    g = BowlingGame()
    for r in rolls:
        g.roll(r)
    return g.score()

cases = [
    ("gutter game", [0]*20, 0),
    ("all ones", [1]*20, 20),
    ("one spare", [6,4,3,0]+[0]*16, 16),
    ("one strike", [10,3,4]+[0]*16, 24),
    ("perfect game", [10]*12, 300),
    ("all spares", [5]*21, 150),
    ("10th spare fill", [0]*18+[7,3,5], 15),
    ("10th strike fill", [0]*18+[10,10,10], 30),
    ("example X 5/ 90", [10,5,5,9,0]+[0]*15, 48),
    ("all open 9/0", [9,0]*10, 90),
]
ok = True
for name, rolls, expected in cases:
    got = play(rolls)
    status = "PASS" if got == expected else "FAIL"
    if got != expected:
        ok = False
    print(f"{status}: {name} -> got {got}, expected {expected}")
print("ALL PASS" if ok else "FAILURES PRESENT")
'
