    PhoneNumber('123456789012')
    print('FAIL: too many digits should raise')
except ValueError as e:
    print(f'PASS: too many -> ValueError: {e}')

# 11 digits not starting with 1
try:
    PhoneNumber('22345678901')
    print('FAIL: 11 digits not starting with 1 should raise')
except ValueError as e:
    print(f'PASS: 11 no 1 -> ValueError: {e}')

print()
print('All tests passed!')
