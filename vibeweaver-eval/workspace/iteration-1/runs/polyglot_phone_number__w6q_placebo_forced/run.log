from phone_number import PhoneNumber

# Basic valid tests
tests = [
    ('+1 (613)-995-0253', '6139950253'),
    ('613-995-0253', '6139950253'),
    ('1 613 995 0253', '6139950253'),
    ('613.995.0253', '6139950253'),
    ('2234567890', '2234567890'),
    ('3234567890', '3234567890'),
    ('2232234567', '2232234567'),
]

for inp, expected in tests:
    p = PhoneNumber(inp)
    assert p.number == expected, f'FAIL: {inp} -> {p.number} (expected {expected})'
    print(f'PASS: {inp} -> {p.number}')

# Error cases
errors = [
    ('0234567890', 'area code cannot start with zero'),
    ('1234567890', 'area code cannot start with one'),
    ('2230567890', 'exchange code cannot start with zero'),
    ('2231567890', 'exchange code cannot start with one'),
]

for inp, msg in errors:
    try:
        PhoneNumber(inp)
        print(f'FAIL: {inp} should have raised ValueError')
    except ValueError as e:
        assert msg in str(e), f'FAIL: wrong error for {inp}: {e}'
        print(f'PASS: {inp} -> ValueError: {e}')

# Letters
try:
    PhoneNumber('123-abc-7890')
    print('FAIL: letters should raise')
except ValueError as e:
    print(f'PASS: letters -> ValueError: {e}')

# Punctuation
try:
    PhoneNumber('123-@-7890')
    print('FAIL: @ should raise')
except ValueError as e:
    print(f'PASS: @ punctuation -> ValueError: {e}')

# Too few digits
try:
    PhoneNumber('123456789')
    print('FAIL: too few digits should raise')
except ValueError as e:
    print(f'PASS: too few -> ValueError: {e}')

# Too many digits
try:
    PhoneNumber('123456789012')
    print('FAIL: too many digits should raise')
except ValueError as e:
    print(f'PASS: too many -> ValueError: {e}')

# 11 digits not starting with 1
try:
    PhoneNumber('22345678901')
    print('FAIL: 11 digits not starting with 1 should raise')
except ValueError as e:
    print(f'PASS: 11 no 1 -> ValueError: {e}')

# 11 digits with country code 1
p = PhoneNumber('12234567890')
assert p.number == '2234567890', f'FAIL: {p.number}'
print(f'PASS: 12234567890 -> {p.number}')

print()
print('All tests passed!')
"

