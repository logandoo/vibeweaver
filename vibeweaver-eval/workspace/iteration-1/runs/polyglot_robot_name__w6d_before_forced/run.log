import re
from robot_name import Robot

# format
r = Robot()
assert re.fullmatch(r'[A-Z]{2}[0-9]{3}', r.name), r.name
print('format ok:', r.name)

# lazy / stable
assert r.name == r.name
print('stable ok')

# reset -> new name
old = r.name
r.reset()
new = r.name
assert re.fullmatch(r'[A-Z]{2}[0-9]{3}', new)
assert new != old, (old, new)
print('reset ok:', old, '->', new)

# uniqueness across many robots
names = [Robot().name for _ in range(5000)]
assert len(names) == len(set(names)), 'collision detected'
print('uniqueness ok:', len(names), 'robots,', len(set(names)), 'unique')
