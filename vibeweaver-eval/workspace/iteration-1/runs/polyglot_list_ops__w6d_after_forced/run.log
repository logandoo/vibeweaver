check(2,  "append([], [1,2,3,4])", m.append([], [1,2,3,4]), [1,2,3,4])
check(3,  "append([1,2,3,4], [])", m.append([1,2,3,4], []), [1,2,3,4])
check(4,  "append([1,2],[2,3,4,5])", m.append([1,2],[2,3,4,5]), [1,2,2,3,4,5])
check(5,  "concat([])", m.concat([]), [])
check(6,  "concat flat", m.concat([[1,2],[3],[],[4,5,6]]), [1,2,3,4,5,6])
check(7,  "concat nested", m.concat([[[1],[2]],[[3]],[[]],[[4,5,6]]]), [[1],[2],[3],[],[4,5,6]])
check(8,  "filter(is_odd, [])", m.filter(is_odd, []), [])
check(9,  "filter(is_odd, [1,2,3,5])", m.filter(is_odd, [1,2,3,5]), [1,3,5])
check(10, "length([])", m.length([]), 0)
check(11, "length([1,2,3,4])", m.length([1,2,3,4]), 4)
check(12, "map(x+1, [])", m.map(lambda x: x + 1, []), [])
check(13, "map(x+1, [1,3,5,7])", m.map(lambda x: x + 1, [1,3,5,7]), [2,4,6,8])
check(14, "foldl(*, [], 2)", m.foldl(lambda acc, el: el * acc, [], 2), 2)
check(15, "foldl(+, [1,2,3,4], 5)", m.foldl(lambda acc, el: el + acc, [1,2,3,4], 5), 15)
check(16, "foldl(/, [1,2,3,4], 24)", m.foldl(lambda acc, el: el / acc, [1,2,3,4], 24), 64)
check(17, "foldr(*, [], 2)", m.foldr(lambda acc, el: el * acc, [], 2), 2)
check(18, "foldr(+, [1,2,3,4], 5)", m.foldr(lambda acc, el: el + acc, [1,2,3,4], 5), 15)
check(19, "foldr(/, [1,2,3,4], 24)", m.foldr(lambda acc, el: el / acc, [1,2,3,4], 24), 9)
check(20, "foldr(string)", m.foldr(lambda acc, el: el + acc, ["e","x","e","r","c","i","s","m"], "!"), "exercism!")
check(21, "reverse([])", m.reverse([]), [])
check(22, "reverse([1,3,5,7])", m.reverse([1,3,5,7]), [7,5,3,1])
check(23, "reverse(lists)", m.reverse([[1,2],[3],[],[4,5,6]]), [[4,5,6],[],[3],[1,2]])
expected_exports = ["append","concat","filter","foldl","foldr","length","map","reverse"]
actual_exports = sorted(n for n in dir(m) if not n.startswith("_"))
check(24, "exports", actual_exports, expected_exports)

passed = sum(results)
print(f"\nTOTAL: {passed}/{len(results)} passed, {len(results)-passed} failed")
raise SystemExit(0 if passed == len(results) else 1)
