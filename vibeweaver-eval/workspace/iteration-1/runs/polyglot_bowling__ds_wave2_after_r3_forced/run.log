from bowling import BowlingGame

passed = 0
failed = 0

def check(name, cond):
    global passed, failed
    if cond:
        passed += 1
    else:
        failed += 1
        print(f"FAIL: {name}")

def score_of(rolls):
    g = BowlingGame()
    for r in rolls:
        g.roll(r)
    return g.score()

def expect_error(name, rolls, bad_roll=None, score_before=False):
    global passed, failed
    try:
        g = BowlingGame()
        for r in rolls:
            g.roll(r)
        if score_before:
            g.score()
        elif bad_roll is not None:
            g.roll(bad_roll)
        failed += 1
        print(f"FAIL (no error raised): {name}")
    except Exception as e:
        if str(e):
            passed += 1
        else:
            failed += 1
            print(f"FAIL (empty message): {name} -> {e!r}")

