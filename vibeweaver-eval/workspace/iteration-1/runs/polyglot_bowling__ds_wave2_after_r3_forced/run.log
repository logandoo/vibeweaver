[0m$ [0mpython3 - <<'PY'
import urllib.request, ast, re
from bowling import BowlingGame

url = "https://raw.githubusercontent.com/exercism/python/main/exercises/practice/bowling/bowling_test.py"
data = urllib.request.urlopen(url).read().decode()

lines = data.splitlines()
# find indices of test defs (4-space indented)
defs = [i for i, l in enumerate(lines) if l.startswith("    def test_")]
methods = []
for k, start in enumerate(defs):
    end = defs[k+1] if k+1 < len(defs) else len(lines)
    # body is everything up to next def; skip the def signature lines
    body = "\n".join(lines[start:end])
    name = re.search(r"def (test_\w+)\(", body).group(1)
    methods.append((name, body))

passed = failed = 0
for name, body in methods:
    m = re.search(r"rolls = \[(.*?)\]", body, re.S)
    rolls = ast.literal_eval("[" + m.group(1) + "]") if m else []
    score_m = re.search(r"assertEqual\(game\.score\(\), (\d+)\)", body)
    if score_m:
        expected = int(score_m.group(1))
        try:
            g = BowlingGame()
            for r in rolls:
                g.roll(r)
            got = g.score()
            ok = got == expected
        except Exception as e:
            ok = False; got = f"EXC {e!r}"
        if ok: passed += 1
        else:
            failed += 1
            print(f"FAIL {name}: rolls={rolls} expected={expected} got={got}")
        continue
    # error test: find the statement inside assertRaisesWithMessage block
    inner = re.search(r"assertRaisesWithMessage\(Exception\):\n(    )+(.*)", body)
    if not inner:
        failed += 1; print(f"FAIL {name}: unparsed error test"); continue
    stmt = inner.group(2).strip()
    try:
        g = BowlingGame()
        for r in rolls:
            g.roll(r)
        if stmt.startswith("game.score()"):
            g.score()
        elif stmt.startswith("game.roll("):
            g.roll(ast.literal_eval(stmt[len("game.roll("):-1]))
        else:
            raise RuntimeError("unknown stmt " + stmt)
        failed += 1
        print(f"FAIL {name}: expected error, none raised (rolls={rolls}, action={stmt})")
    except Exception as e:
        if str(e): passed += 1
        else:
            failed += 1
            print(f"FAIL {name}: empty message -> {e!r}")

print(f"\nTotal methods parsed: {len(methods)}")
print(f"CANONICAL SUITE: PASS={passed} FAIL={failed}")
