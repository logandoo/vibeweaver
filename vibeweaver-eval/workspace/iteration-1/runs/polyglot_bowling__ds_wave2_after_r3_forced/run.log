import urllib.request, ast, re
from bowling import BowlingGame

url = "https://raw.githubusercontent.com/exercism/python/main/exercises/practice/bowling/bowling_test.py"
data = urllib.request.urlopen(url).read().decode()

# Split into test methods
methods = re.findall(r"    def (test_\w+)\(self\):\n((?:.*\n)*?)(?=    def |$)", data)

passed = failed = 0

for name, body in methods:
    m = re.search(r"rolls = \[(.*?)\]", body, re.S)
    rolls = ast.literal_eval("[" + m.group(1) + "]") if m else []
    score_m = re.search(r"assertEqual\(game\.score\(\), (\d+)\)", body)
    if score_m:
        expected = int(score_m.group(1))
        try:
            g = BowlingGame()
            for r in rolls:
                g.roll(r)
            got = g.score()
            ok = got == expected
        except Exception as e:
            ok = False
            got = f"EXC {e!r}"
        if ok:
            passed += 1
        else:
            failed += 1
            print(f"FAIL {name}: rolls={rolls} expected={expected} got={got}")
        continue
    # error test
    act_m = re.search(r"assertRaisesWithMessage\(Exception\):\n(\s+)(game\.(roll)\((-?\d+)\)|game\.score\(\))", body)
    if not act_m:
        failed += 1
        print(f"FAIL {name}: could not parse error test")
        continue
    stmt = act_m.group(2)
    try:
        g = BowlingGame()
        for r in rolls:
            g.roll(r)
        if stmt.startswith("game.score()"):
            g.score()
        else:
            g.roll(ast.literal_eval(act_m.group(4)))
        failed += 1
        print(f"FAIL {name}: expected error, none raised (rolls={rolls}, action={stmt.strip()})")
    except Exception as e:
        if str(e):
            passed += 1
        else:
            failed += 1
            print(f"FAIL {name}: empty error message -> {e!r}")

print(f"\nCANONICAL SUITE: PASS={passed} FAIL={failed}")
