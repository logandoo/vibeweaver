import urllib.request, ast, re
from bowling import BowlingGame
url = "https://raw.githubusercontent.com/exercism/python/main/exercises/practice/bowling/bowling_test.py"
data = urllib.request.urlopen(url).read().decode()
lines = data.splitlines()
defs = [i for i, l in enumerate(lines) if l.startswith("    def test_")]
methods = []
for k, s in enumerate(defs):
    e = defs[k+1] if k+1 < len(defs) else len(lines)
    methods.append((re.search(r"def (test_\w+)\(", lines[s]).group(1), "\n".join(lines[s:e])))
passed = failed = 0
for name, body in methods:
    m = re.search(r"rolls = \[(.*?)\]", body, re.S)
    rolls = ast.literal_eval("[" + m.group(1) + "]") if m else []
    if (sm := re.search(r"assertEqual\(game\.score\(\), (\d+)\)", body)):
        g = BowlingGame()
        for r in rolls: g.roll(r)
        if g.score() == int(sm.group(1)): passed += 1
        else: failed += 1; print("FAIL", name)
        continue
    inner = re.search(r"assertRaisesWithMessage\(Exception\):\n(    )+(.*)", body)
    try:
        g = BowlingGame()
        for r in rolls: g.roll(r)
        stmt = inner.group(2).strip()
        if stmt.startswith("game.score()"): g.score()
        else: g.roll(ast.literal_eval(stmt[len("game.roll("):-1]))
        failed += 1; print("FAIL (no raise)", name)
    except Exception as ex:
        if str(ex): passed += 1
        else: failed += 1; print("FAIL (empty msg)", name)
print(f"FRESH RUN: PASS={passed} FAIL={failed}")
g = BowlingGame()
for r in [10,5,5,9,0]: g.roll(r)
print("prompt example [10,5,5,9,0] -> partial-frame math; full game 300 check:",
      (lambda gg: [gg.roll(10) for _ in range(12)], gg.score())[0] and None or None) if False else None
g2 = BowlingGame()
for r in [10]*12: g2.roll(r)
print("perfect game:", g2.score())
