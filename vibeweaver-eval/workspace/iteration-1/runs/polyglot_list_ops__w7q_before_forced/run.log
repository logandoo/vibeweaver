# foldr: processes from right, so for [1,2,3] with init=0:
# f(f(f(0, 3), 2), 1) = f(f(-3, 2), 1) = f(-5, 1) = -6
result = list_ops.foldr(lambda acc, x: acc - x, [1, 2, 3], 0)
