from phone_number import PhoneNumber

# Test basic cases
tests = [
    ('+1 (613)-995-0253', '6139950253'),
    ('613-995-0253', '6139950253'),
    ('1 613 995 0253', '6139950253'),
    ('613.995.0253', '6139950253'),
    ('1234567890', '1234567890'),
    ('(223) 456-7890', '2234567890'),
    ('2234567890', '2234567890'),
]

for inp, expected in tests:
    pn = PhoneNumber(inp)
    assert pn.number == expected, f'{inp}: expected {expected}, got {pn.number}'
    print(f'PASS: {inp} -> {pn.number}')

# Test area_code
pn = PhoneNumber('613-995-0253')
assert pn.area_code == '613', f'area_code: expected 613, got {pn.area_code}'
print(f'PASS: area_code = {pn.area_code}')

# Test pretty
assert pn.pretty() == '(613)-995-0253', f'pretty: expected (613)-995-0253, got {pn.pretty()}'
print(f'PASS: pretty = {pn.pretty()}')

# Test error cases
import traceback
errors = [
    ('ab-cdef-ghij', 'letters not permitted'),
    ('123-abc-7890', 'letters not permitted'),
    ('123-@:!-7890', 'punctuations not permitted'),
    ('123', 'must not be fewer than 10 digits'),
    ('123456789012', 'must not be greater than 11 digits'),
    ('22345678901', '11 digits must start with 1'),
    ('0234567890', 'area code cannot start with zero'),
    ('1234567890', 'area code cannot start with one'),
    ('2230567890', 'exchange code cannot start with zero'),
    ('2231567890', 'exchange code cannot start with one'),
]

for inp, msg in errors:
