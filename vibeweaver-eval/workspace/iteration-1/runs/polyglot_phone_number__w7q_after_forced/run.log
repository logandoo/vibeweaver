        PhoneNumber(inp)
        print(f'FAIL: {inp} should have raised ValueError(\"{msg}\")')
    except ValueError as e:
        assert str(e) == msg, f'{inp}: expected \"{msg}\", got \"{e}\"'
        print(f'PASS error: {inp} -> {e}')

print()
print('All tests passed!')
"

