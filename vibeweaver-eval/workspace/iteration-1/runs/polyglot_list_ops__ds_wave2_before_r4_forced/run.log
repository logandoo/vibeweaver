import random
import sys
from functools import reduce
import list_ops

random.seed(42)
checks = 0
fails = []

def check(name, got, want):
    global checks
    checks += 1
    if got != want:
        fails.append((name, got, want))

def rand_list(depth=0):
    if depth > 2:
        return random.randint(-50, 50)
    n = random.randint(0, 6)
    return [rand_list(depth + 1) if random.random() < 0.2 else random.randint(-50, 50) for _ in range(n)]

for _ in range(300):
    a, b = rand_list(), rand_list()
    check("append", list_ops.append(a, b), a + b)
    check("length", list_ops.length(a), len(a))

for _ in range(300):
    ll = [rand_list() for _ in range(random.randint(0, 5))]
    want = [e for sub in ll for e in sub]
    check("concat", list_ops.concat(ll), want)
    check("reverse", list_ops.reverse(ll), ll[::-1])

for _ in range(300):
    l = rand_list()
    check("map", list_ops.map(lambda x: x * 3 if isinstance(x, int) else x, l),
          [x * 3 if isinstance(x, int) else x for x in l])

for _ in range(300):
    l = [random.randint(-20, 20) for _ in range(random.randint(0, 8))]
    check("filter", list_ops.filter(lambda x: x % 2 == 0, l), [x for x in l if x % 2 == 0])

for _ in range(300):
    l = [random.randint(1, 9) for _ in range(random.randint(0, 8))]
    init = random.randint(1, 9)
    check("foldl", list_ops.foldl(lambda a, e: a - e, l, init), reduce(lambda a, e: a - e, l, init))
    check("foldr", list_ops.foldr(lambda a, e: a / e, l, init), reduce(lambda a, e: e / a, reversed(l), init))

for _ in range(300):
    l = rand_list()
    check("concat_self", list_ops.concat([l, list_ops.reverse(l)]), l + l[::-1])

print(f"differential sweep: {checks} checks, {len(fails)} mismatches")
for name, got, want in fails[:10]:
    print(f"  MISMATCH {name}: got={got!r} want={want!r}")
sys.exit(1 if fails else 0)
EOF
