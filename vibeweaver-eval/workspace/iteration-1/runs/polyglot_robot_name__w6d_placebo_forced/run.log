import re, random
from robot_name import Robot

random.seed(0)
# lazy naming + format
r = Robot()
assert r._name is None, 'name should be empty before first access'
n = r.name
assert re.fullmatch(r'[A-Z]{2}[0-9]{3}', n), n
assert r.name == n, 'name should be stable once set'

# uniqueness across many robots
robots = [Robot() for _ in range(20000)]
names = [b.name for b in robots]
assert len(names) == len(set(names)), 'duplicate names!'

# reset wipes and regenerates
old = robots[0].name
robots[0].reset()
assert robots[0]._name is None
new = robots[0].name
assert re.fullmatch(r'[A-Z]{2}[0-9]{3}', new), new

# freed name is reusable / still globally unique at any instant
all_current = [b.name for b in robots]
assert len(all_current) == len(set(all_current)), 'duplicate after reset!'

print('all checks passed; sample:', names[:3], 'reset produced:', old, '->', new)
"
all checks passed; sample: ['QP647', 'LS382', 'JE194'] reset produced: QP647 -> GR075
