from variable_length_quantity import encode, decode

# Prompt example table (12 cases)
table = {
    0x00000000: [0x00],
    0x00000040: [0x40],
    0x0000007F: [0x7F],
    0x00000080: [0x81, 0x00],
    0x00002000: [0xC0, 0x00],
    0x00003FFF: [0xFF, 0x7F],
    0x00004000: [0x81, 0x80, 0x00],
    0x00100000: [0xC0, 0x80, 0x00],
    0x001FFFFF: [0xFF, 0xFF, 0x7F],
    0x00200000: [0x81, 0x80, 0x80, 0x00],
    0x08000000: [0xC0, 0x80, 0x80, 0x00],
    0x0FFFFFFF: [0xFF, 0xFF, 0xFF, 0x7F],
}
for n, expected in table.items():
    assert encode([n]) == expected, (n, encode([n]), expected)
print("prompt table: 12/12 OK")

# Round-trip property over 2000 random 32-bit values
random.seed(20260829)
vals = [random.randint(0, 0xFFFFFFFF) for _ in range(2000)]
enc = encode(vals)
dec = decode(enc)
assert dec == vals, "round-trip mismatch"
print("round-trip: 2000/2000 OK (encode len=%d)" % len(enc))

# Empty inputs
