# Encode/decode empty + single values sanity
assert decode(encode([0])) == [0]
assert decode(encode([0xFFFFFFFF])) == [0xFFFFFFFF]
print("boundary: 0 and 0xFFFFFFFF OK")
print("ALL ROUNDTRIP CHECKS PASSED")
