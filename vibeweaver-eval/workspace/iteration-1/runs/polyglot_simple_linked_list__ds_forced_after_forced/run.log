check("list(LinkedList([1,2,3])) == [3,2,1]", list(LinkedList([1,2,3])) == [3,2,1])
check("reversed empty == []", list(LinkedList([]).reversed()) == [])
check("reversed singleton == [1]", list(LinkedList([1]).reversed()) == [1])
