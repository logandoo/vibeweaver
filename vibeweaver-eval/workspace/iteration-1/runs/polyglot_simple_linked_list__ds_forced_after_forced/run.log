from simple_linked_list import LinkedList, EmptyListException

PASS = 0
FAIL = 0

def check(name, cond, detail=""):
    global PASS, FAIL
    if cond:
        PASS += 1
        print(f"PASS  {name}{('  ' + detail) if detail else ''}")
    else:
        FAIL += 1
        print(f"FAIL  {name}{('  ' + detail) if detail else ''}")

def raises_empty(fn):
    try:
        fn()
        return False
    except EmptyListException as e:
        return e.args[0] == "The list is empty."

# 1-3 lengths
check("len(LinkedList()) == 0", len(LinkedList()) == 0, f"got {len(LinkedList())}")
check("len(LinkedList([1])) == 1", len(LinkedList([1])) == 1, f"got {len(LinkedList([1]))}")
check("len(LinkedList([1,2,3])) == 3", len(LinkedList([1, 2, 3])) == 3, f"got {len(LinkedList([1,2,3]))}")

# 4-6 head
check("empty head raises EmptyListException('The list is empty.')", raises_empty(lambda: LinkedList().head()))
check("singleton head value == 1", LinkedList([1]).head().value() == 1)
check("LinkedList([1,2]).head().value() == 2", LinkedList([1, 2]).head().value() == 2)

# 7-8 push
ll = LinkedList([1, 2, 3]); ll.push(4)
check("push to non-empty -> len 4", len(ll) == 4, f"got {len(ll)}")
ll2 = LinkedList(); ll2.push(5)
check("push to empty -> len 1 + head 5", len(ll2) == 1 and ll2.head().value() == 5)

# 9-11 pop
ll = LinkedList([3, 4, 5])
v = ll.pop()
check("pop() == 5", v == 5, f"got {v}")
check("after pop len == 2 + head 4", len(ll) == 2 and ll.head().value() == 4)
ll = LinkedList([1])
check("singleton pop() == 1", ll.pop() == 1)
check("after singleton pop head raises", raises_empty(lambda: ll.head()))
check("empty pop raises EmptyListException", raises_empty(lambda: LinkedList().pop()))

# 12 push/pop interleaved
ll = LinkedList([1, 2]); ll.push(3)
seq = [ll.pop(), ll.pop(), ll.pop()]
check("push/pop sequence 3,2,1", seq == [3, 2, 1], f"got {seq}")
check("after pop all len == 0", len(ll) == 0, f"got {len(ll)}")
ll.push(4)
check("after re-push len == 1 + head 4", len(ll) == 1 and ll.head().value() == 4)

# 13 next() chain
check("singleton head().next() is None", LinkedList([1]).head().next() is None)

# 14 traverse range(10)
ll = LinkedList(range(10))
cur = ll.head()
vals = []
while cur is not None:
    vals.append(cur.value())
    cur = cur.next()
check("range(10) traverses 9..0 then None", vals == [9, 8, 7, 6, 5, 4, 3, 2, 1, 0] and cur is None, f"got {vals}")

# 15-17 iteration
check("list(LinkedList()) == []", list(LinkedList()) == [])
check("list(LinkedList([1])) == [1]", list(LinkedList([1])) == [1])
check("list(LinkedList([1,2,3])) == [3,2,1]", list(LinkedList([1, 2, 3])) == [3, 2, 1])

# 18-20 reversed
check("reversed empty == []", list(LinkedList([]).reversed()) == [])
check("reversed singleton == [1]", list(LinkedList([1]).reversed()) == [1])
check("reversed [1,2,3] == [1,2,3]", list(LinkedList([1, 2, 3]).reversed()) == [1, 2, 3])

# 21 import/compile (already imported at top)
check("module imports cleanly", True)

print(f"\nTOTAL: {PASS}/{PASS + FAIL} passed, {FAIL} failed")
EOF
