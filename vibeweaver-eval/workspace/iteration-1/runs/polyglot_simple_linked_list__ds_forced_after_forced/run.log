def raises_empty(fn):
    try: fn(); return False
    except EmptyListException as e: return e.args[0] == "The list is empty."
check("len(LinkedList()) == 0", len(LinkedList()) == 0)
check("len(LinkedList([1])) == 1", len(LinkedList([1])) == 1)
check("len(LinkedList([1,2,3])) == 3", len(LinkedList([1,2,3])) == 3)
check("empty head raises EmptyListException", raises_empty(lambda: LinkedList().head()))
check("singleton head value == 1", LinkedList([1]).head().value() == 1)
check("LinkedList([1,2]).head().value() == 2", LinkedList([1,2]).head().value() == 2)
ll = LinkedList([1,2,3]); ll.push(4); check("push non-empty len 4", len(ll) == 4)
ll2 = LinkedList(); ll2.push(5); check("push empty len 1 + head 5", len(ll2)==1 and ll2.head().value()==5)
ll = LinkedList([3,4,5]); v=ll.pop(); check("pop()==5", v==5); check("post-pop len 2 + head 4", len(ll)==2 and ll.head().value()==4)
ll = LinkedList([1]); check("singleton pop()==1", ll.pop()==1); check("post-singleton-pop head raises", raises_empty(lambda: ll.head()))
check("empty pop raises", raises_empty(lambda: LinkedList().pop()))
