import random, sys
sys.path.insert(0, "/Users/logan/Documents/DEV/SKILLS/vibeweaver-repo/vibeweaver-eval/workspace/iteration-1/runs/polyglot_variable_length_quantity__ds_wave2_after_r3_forced")
from variable_length_quantity import encode, decode

def encode_ref(numbers):
    out = []
    for n in numbers:
        bits = bin(n)[2:]
        pad = (-len(bits)) % 7
        groups = [bits[:pad].lstrip("0")] + [bits[i:i+7] for i in range(max(pad,0), len(bits), 7)]
        groups = [g for g in groups if g != ""]
        if not groups:
            groups = ["0"]
        for i, g in enumerate(groups):
            b = int(g, 2)
            if i < len(groups) - 1:
                b |= 0x80
            out.append(b)
    return out

def decode_ref(bs):
    vals, val, cont = [], 0, False
    for b in bs:
        val = (val << 7) | (b & 0x7F)
        cont = b & 0x80
        if not cont:
            vals.append(val)
            val = 0
    if cont:
        raise ValueError("incomplete sequence")
    return vals

random.seed(20260829)
fails = 0
checks = 0

def chk(cond, label):
    global fails, checks
    checks += 1
    if not cond:
        fails += 1
        print(f"FAIL: {label}")

table = [(0x0,), (0x40,), (0x7F,), (0x80,), (0x2000,), (0x3FFF,), (0x4000,), (0x100000,),
         (0x1FFFFF,), (0x200000,), (0x8000000,), (0xFFFFFFF,), (0x10000000,), (0xFF000000,),
         (0xFFFFFFFF,)]
for t in table:
    chk(encode(list(t)) == encode_ref(list(t)), f"encode table {t}")
    chk(decode(encode(list(t))) == list(t), f"roundtrip table {t}")

multi = [(0x40, 0x7F), (0x4000, 0x123456),
         (0x2000, 0x123456, 0xFFFFFFF, 0x0, 0x3FFF, 0x4000)]
for m in multi:
    chk(encode(list(m)) == encode_ref(list(m)), f"encode multi {m}")
    chk(decode(encode(list(m))) == list(m), f"roundtrip multi {m}")

chk(encode([]) == [] and encode_ref([]) == [], "encode empty")
chk(decode([]) == [], "decode empty")

for _ in range(5000):
    n = random.getrandbits(32)
    chk(encode([n]) == encode_ref([n]), f"encode rand {n:#x}")
    chk(decode(encode([n])) == [n], f"roundtrip rand {n:#x}")

vals = [random.getrandbits(32) for _ in range(50)]
chk(encode(vals) == encode_ref(vals), "encode random multi list")
chk(decode(encode(vals)) == vals, "roundtrip random multi list")

for seq in ([0xFF], [0x80], [0x80, 0x80], [0xC0], [0x81], [0xFF, 0x81]):
    try:
        decode(list(seq))
        chk(False, f"incomplete seq {seq}")
    except ValueError as e:
        chk(str(e) == "incomplete sequence", f"incomplete msg {seq}: {e}")

for bad in ([-1], [0x100000000], [0xFFFFFFFF + 1]):
    try:
        encode(list(bad))
        chk(False, f"encode range {bad}")
    except ValueError:
        pass

print(f"SWEEP DONE: checks={checks} failures={fails}")
sys.exit(0 if fails == 0 else 1)
EOF
