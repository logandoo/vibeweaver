from variable_length_quantity import encode, decode

def encode_ref(n):
    bits = bin(n)[2:]
    pad = (-len(bits)) % 7
    if pad == 0:
        groups = [bits[i:i+7] for i in range(0, len(bits), 7)]
    else:
        groups = [bits[:pad]] + [bits[i:i+7] for i in range(pad, len(bits), 7)]
    out = []
    for i, g in enumerate(groups):
        b = int(g, 2)
        if i < len(groups) - 1:
            b |= 0x80
        out.append(b)
    return out

