Found the real bug: the reference splits `bin(n)[2:]` directly, so the leading 7-bit group isn't zero-padded to a full 7 bits (for 0x46121b10, correct first group is `0000100`, not `1000`). Fix: `zfill` the bit string to a multiple of 7, then split uniformly.
The corrected reference matches my implementation. Re-running the full sweep for clean evidence:
[0m$ [0mpython3 - <<'EOF'
import random, sys, os
sys.path.insert(0, "/Users/logan/Documents/DEV/SKILLS/vibeweaver-repo/vibeweaver-eval/workspace/iteration-1/runs/polyglot_variable_length_quantity__ds_wave2_after_r3_forced")
from variable_length_quantity import encode, decode

def encode_ref(n):
    bits = bin(n)[2:]
    bits = bits.zfill((-len(bits)) % 7 + len(bits))
    groups = [bits[i:i+7] for i in range(0, len(bits), 7)]
    return [int(g, 2) | (0x80 if i < len(groups)-1 else 0) for i, g in enumerate(groups)]

def decode_ref(bs):
    value = 0; out = []
    for byte in bs:
        value = (value << 7) | (byte & 0x7F)
        if not (byte & 0x80):
            out.append(value); value = 0
    if value: raise ValueError("incomplete sequence")
    return out

MAX = 0xFFFFFFFF
check_total = 0; check_passed = 0; check_failed = 0; failures = []
def check(desc, a, b, *ctx):
    global check_total, check_passed, check_failed
    check_total += 1
    if a == b:
        check_passed += 1
    else:
        check_failed += 1
        failures.append(f"{desc}: {ctx} mine={a} ref={b}")

def scan_range(desc, n0, n1):
    step = max(1, (n1 - n0) // 40000)
    for n in range(n0, n1 + 1, step):
        mine, ref = encode([n]), encode_ref(n)
        check(f"encode {desc} 0x{n:08x}", mine, ref, n)
        check(f"roundtrip {desc} 0x{n:08x}", decode(mine), [n], n)

scan_range("rand", 0, MAX)
random.seed(42)
for _ in range(10000):
    n = random.getrandbits(random.choice([1, 7, 14, 21, 28, 31, 32]))
    if n > MAX: continue
    mine, ref = encode([n]), encode_ref(n)
    check(f"encode rand 0x{n:08x}", mine, ref, n)
    check(f"roundtrip rand 0x{n:08x}", decode(mine), [n], n)

import random as r
r.seed(7)
for _ in range(2000):
    n = r.randint(0, MAX)
    check(f"encode rand2 0x{n:08x}", encode([n]), encode_ref(n), n)
    check(f"roundtrip rand2 0x{n:08x}", decode(encode([n])), [n], n)

multi_fails = 0
for _ in range(2000):
    k = r.randint(1, 8)
    nums = [r.randint(0, MAX) for _ in range(k)]
    mine = encode(nums); ref = [b for n in nums for b in encode_ref(n)]
    check(f"encode multi {nums}", mine, ref, nums)
    check(f"roundtrip multi {nums}", decode(mine), nums, nums)

print(f"SWEEP DONE: checks={check_total} passed={check_passed} failed={check_failed}")
for f in failures[:20]:
    print("FAIL:", f)
sys.exit(0 if check_failed == 0 else 1)
