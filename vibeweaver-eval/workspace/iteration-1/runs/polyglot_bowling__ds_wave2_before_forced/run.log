import random, sys
sys.path.insert(0, "/Users/logan/Documents/DEV/SKILLS/vibeweaver-repo/vibeweaver-eval/workspace/iteration-1/runs/polyglot_bowling__ds_wave2_before_forced")
from bowling import BowlingGame

def reference(rolls):
    """Independent frame-based reference scorer."""
    i = 0
    frames = []
    for _ in range(10):
        if i >= len(rolls):
            break
        if rolls[i] == 10:
            frames.append((10, [rolls[i], rolls[i+1], rolls[i+2]] if i+2 < len(rolls) else None))
            i += 1
        elif i + 1 < len(rolls) and rolls[i] + rolls[i+1] == 10:
            frames.append((1, [rolls[i+2]] if i+2 < len(rolls) else None))
            i += 2
        else:
            frames.append((0, [rolls[i] + rolls[i+1]] if i+1 < len(rolls) else None))
            i += 2
    total = 0
    i = 0
    for f in range(10):
        if i >= len(rolls):
            break
        if rolls[i] == 10:
            total += 10 + rolls[i+1] + rolls[i+2]
            i += 1
        elif rolls[i] + rolls[i+1] == 10:
            total += 10 + rolls[i+2]
            i += 2
        else:
            total += rolls[i] + rolls[i+1]
            i += 2
    return total

def random_valid_game():
    """Generate a random complete valid game."""
    rolls = []
    # frames 1-9
    for _ in range(9):
        r = random.randint(0, 10)
        if r == 10:
            rolls.append(10)
        else:
            rolls.append(r)
            rolls.append(random.randint(0, 10 - r))
    # frame 10
    r1 = random.randint(0, 10)
    if r1 == 10:
        r2 = random.randint(0, 10)
        rolls.append(10)
        if r2 == 10:
            rolls.append(10)
            rolls.append(random.randint(0, 10))
        else:
            rolls.append(r2)
            rolls.append(random.randint(0, 10 - r2))
    else:
        rolls.append(r1)
        r2 = random.randint(0, 10 - r1)
        rolls.append(r2)
        if r1 + r2 == 10:
            rolls.append(random.randint(0, 10))
    return rolls

random.seed(42)
mismatches = 0
for n in range(5000):
    rolls = random_valid_game()
    g = BowlingGame()
    for p in rolls:
        g.roll(p)
    got = g.score()
    exp = reference(rolls)
    if got != exp:
        mismatches += 1
        print(f"MISMATCH {rolls}: got {got}, expected {exp}")
        if mismatches > 5:
            break
print(f"random differential check: {5000} games, {mismatches} mismatches")
