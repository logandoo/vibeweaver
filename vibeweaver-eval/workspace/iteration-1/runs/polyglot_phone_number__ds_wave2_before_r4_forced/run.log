import sys, traceback
sys.path.insert(0, ".")
from phone_number import PhoneNumber

def num(n):
    return PhoneNumber(n).number

def err(n):
    try:
        PhoneNumber(n)
        return None
    except ValueError as e:
        return str(e)

cases = [
    ("number", "+1 (613)-995-0253", "6139950253"),
    ("number", "613-995-0253", "6139950253"),
    ("number", "1 613 995 0253", "6139950253"),
    ("number", "613.995.0253", "6139950253"),
    ("number", "(223) 456-7890", "2234567890"),
    ("number", "223 456   7890   ", "2234567890"),
    ("number", "12234567890", "2234567890"),
    ("number", "223.456.7890", "2234567890"),
    ("number", "+1 (223) 456-7890", "2234567890"),
    ("error", "123456789", "must not be fewer than 10 digits"),
    ("error", "22234567890", "11 digits must start with 1"),
    ("error", "321234567890", "must not be greater than 11 digits"),
    ("error", "123456789012", "must not be greater than 11 digits"),
    ("error", "(223) 456-78a0", "letters not permitted"),
    ("error", "223.456.78@0", "punctuations not permitted"),
    ("error", "223-456-78:0", "punctuations not permitted"),
    ("error", "223-456-78!0", "punctuations not permitted"),
    ("error", "(023) 456-7890", "area code cannot start with zero"),
    ("error", "(123) 456-7890", "area code cannot start with one"),
    ("error", "223 (056) 7890", "exchange code cannot start with zero"),
    ("error", "223 (156) 7890", "exchange code cannot start with one"),
    ("error", "1 (023) 456-7890", "area code cannot start with zero"),
    ("area_code", "2234567890", "223"),
    ("pretty", "2234567890", "(223)-456-7890"),
    ("pretty", "12234567890", "(223)-456-7890"),
]

passed = failed = 0
for kind, inp, expected in cases:
    try:
        if kind == "number":
            got = num(inp)
            ok = got == expected
        elif kind == "area_code":
            got = PhoneNumber(inp).area_code
            ok = got == expected
        elif kind == "pretty":
            got = PhoneNumber(inp).pretty()
            ok = got == expected
        else:
            got = err(inp)
            ok = got == expected
    except Exception as e:
        got = f"EXC {type(e).__name__}: {e}"
        ok = False
    if ok:
        passed += 1
        print(f"PASS {kind}('{inp}') -> {got!r}")
    else:
        failed += 1
        print(f"FAIL {kind}('{inp}') expected {expected!r} got {got!r}")
print(f"{passed}/{passed+failed} cases PASS")
sys.exit(1 if failed else 0)
EOF
