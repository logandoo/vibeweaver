from phone_number import PhoneNumber

def expect_number(inp, want):
    got = PhoneNumber(inp).number
    assert got == want, f"{inp!r}: got {got!r} want {want!r}"
    print(f"PASS number({inp!r}) == {want!r}")

def expect_error(inp, msg):
    try:
        PhoneNumber(inp)
    except ValueError as e:
        assert str(e) == msg, f"{inp!r}: got {e!r} want {msg!r}"
        print(f"PASS error({inp!r}) -> ValueError({e!r})")
        return
    raise AssertionError(f"{inp!r}: expected ValueError({msg!r}), got none")

def expect_area(inp, want):
    got = PhoneNumber(inp).area_code
    assert got == want, f"{inp!r}: got {got!r} want {want!r}"
    print(f"PASS area_code({inp!r}) == {want!r}")

def expect_pretty(inp, want):
