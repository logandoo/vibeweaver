from variable_length_quantity import encode, decode

cases = {
    0x0: [0x00],
    0x40: [0x40],
    0x7F: [0x7F],
    0x80: [0x81, 0x00],
    0x2000: [0xC0, 0x00],
    0x3FFF: [0xFF, 0x7F],
    0x4000: [0x81, 0x80, 0x00],
    0x100000: [0xC0, 0x80, 0x00],
    0x1FFFFF: [0xFF, 0xFF, 0x7F],
    0x200000: [0x81, 0x80, 0x80, 0x00],
    0x08000000: [0xC0, 0x80, 0x80, 0x00],
    0x0FFFFFFF: [0xFF, 0xFF, 0xFF, 0x7F],
}
for n, expected in cases.items():
    got = encode([n])
    assert got == expected, (hex(n), got, expected)
    assert decode(got) == [n], (hex(n), decode(got))
print('encode/decode cases OK')

assert encode([0x2000, 0x3FFF]) == [0xC0, 0x00, 0xFF, 0x7F]
assert decode([0xC0, 0x00, 0xFF, 0x7F]) == [0x2000, 0x3FFF]
assert encode([0xFFFFFFFF]) == [0x8F, 0xFF, 0xFF, 0xFF, 0x7F]
assert decode([0x8F, 0xFF, 0xFF, 0xFF, 0x7F]) == [0xFFFFFFFF]
print('multi-value and max-uint32 OK')

try:
    decode([0xFF])
except ValueError as e:
    assert str(e) == 'Incomplete sequence', str(e)
    print('incomplete raises:', e)
else:
    raise AssertionError('expected ValueError')
print('ALL OK')
