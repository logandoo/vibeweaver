import sys, random
sys.path.insert(0, '/var/folders/8z/h73xmj297g1995r1d9q6dc2r0000gn/T/opencode/vlq_verify')
from variable_length_quantity import encode, decode

table = {
    0x0: [0x00], 0x40: [0x40], 0x7F: [0x7F], 0x80: [0x81, 0x00],
    0x2000: [0xC0, 0x00], 0x3FFF: [0xFF, 0x7F], 0x4000: [0x81, 0x80, 0x00],
    0x100000: [0xC0, 0x80, 0x00], 0x1FFFFF: [0xFF, 0xFF, 0x7F],
    0x200000: [0x81, 0x80, 0x80, 0x00], 0x8000000: [0xC0, 0x80, 0x80, 0x00],
    0xFFFFFFF: [0xFF, 0xFF, 0xFF, 0x7F],
}
for n, want in table.items():
    got = encode([n])
    assert got == want, (n, got, want)
    assert decode(want) == [n], (n, decode(want))

random.seed(42)
nums = [random.randrange(0, 1 << 32) for _ in range(2000)]
enc = encode(nums)
assert decode(enc) == nums
assert all(b <= 0xFF for b in enc)
assert len(enc) == sum(1 if n == 0 else (n.bit_length() + 6) // 7 for n in nums)

# edge cases
assert encode([]) == [] and decode([]) == []
for bad in ([0x80], [0xFF], [0x80, 0x00, 0x80]):
    try:
        decode(bad)
        raise AssertionError(f"expected ValueError for {bad}")
    except ValueError as e:
        assert str(e) == "incomplete sequence", e

print("OK: table(12) + roundtrip(2000) + edges all passed")
