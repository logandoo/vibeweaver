import simple_linked_list as sll

# Constructor from iterable (canonical: yields reversed order)
l = sll.LinkedList(range(1, 4))
assert list(l) == [3, 2, 1], list(l)
assert len(l) == 3
assert l.head().value() == 3
assert l.head().next().value() == 2

# push / pop
l.push(4)
assert list(l) == [4, 3, 2, 1]
assert len(l) == 4
assert l.pop() == 4
assert l.pop() == 3
assert list(l) == [2, 1]
assert len(l) == 2

# reversed returns new list, original unchanged
r = l.reversed()
assert list(r) == [1, 2], list(r)
assert list(l) == [2, 1]
assert l.reversed().head().value() == 1

# empty list behaviors
e = sll.LinkedList()
assert len(e) == 0
assert list(e) == []
try:
    e.head()
    raise AssertionError('head should raise')
except sll.EmptyListException:
    pass
try:
    e.pop()
    raise AssertionError('pop should raise')
except sll.EmptyListException:
    pass

# Node API
n = sll.Node(5)
assert n.value() == 5
assert n.next() is None

print('ALL CHECKS PASSED')
