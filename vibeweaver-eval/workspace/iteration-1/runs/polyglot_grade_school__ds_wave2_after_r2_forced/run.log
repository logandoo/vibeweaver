from grade_school import School

def check(label, actual, expected):
    status = "PASS" if actual == expected else "FAIL"
    print(f"{status}: {label} -> {actual}")
    if actual != expected:
        raise AssertionError(f"{label}: expected {expected}, got {actual}")

# roster empty
s = School(); check("roster empty", s.roster(), [])

# add a student
s = School(); s.add_student(name="Aimee", grade=2)
check("added one", s.added(), [True])
s = School(); s.add_student(name="Aimee", grade=2)
check("roster one", s.roster(), ["Aimee"])

# multiple in same grade
s = School()
for n in ("Blair", "James", "Paul"): s.add_student(name=n, grade=2)
check("added 3", s.added(), [True, True, True])
s = School()
for n in ("Blair", "James", "Paul"): s.add_student(name=n, grade=2)
check("roster 3 same grade", s.roster(), ["Blair", "James", "Paul"])

# duplicate same grade
s = School()
for n in ("Blair", "James", "James", "Paul"): s.add_student(name=n, grade=2)
check("added dup same grade", s.added(), [True, True, False, True])
s = School()
for n in ("Blair", "James", "James", "Paul"): s.add_student(name=n, grade=2)
check("roster no dup same grade", s.roster(), ["Blair", "James", "Paul"])

# multiple grades
s = School()
s.add_student(name="Chelsea", grade=3); s.add_student(name="Logan", grade=7)
check("added 2 grades", s.added(), [True, True])
s = School()
s.add_student(name="Chelsea", grade=3); s.add_student(name="Logan", grade=7)
check("roster 2 grades", s.roster(), ["Chelsea", "Logan"])

# same student multiple grades
s = School()
s.add_student(name="Blair", grade=2); s.add_student(name="James", grade=2)
s.add_student(name="James", grade=3); s.add_student(name="Paul", grade=3)
check("added dup multi-grade", s.added(), [True, True, False, True])
s = School()
s.add_student(name="Blair", grade=2); s.add_student(name="James", grade=2)
s.add_student(name="James", grade=3); s.add_student(name="Paul", grade=3)
check("roster no dup multi-grade", s.roster(), ["Blair", "James", "Paul"])
check("grade 2", s.grade(2), ["Blair", "James"])
check("grade 3", s.grade(3), ["Paul"])

# sorting
s = School()
s.add_student(name="Jim", grade=3); s.add_student(name="Peter", grade=2); s.add_student(name="Anna", grade=1)
check("sorted by grade", s.roster(), ["Anna", "Peter", "Jim"])
s = School()
for n in ("Peter", "Zoe", "Alex"): s.add_student(name=n, grade=2)
check("sorted by name", s.roster(), ["Alex", "Peter", "Zoe"])
s = School()
for n, g in [("Peter",2),("Anna",1),("Barb",1),("Zoe",2),("Alex",2),("Jim",3),("Charlie",1)]:
    s.add_student(name=n, grade=g)
check("sorted grade then name", s.roster(), ["Anna","Barb","Charlie","Alex","Peter","Zoe","Jim"])

# grade queries
s = School(); check("grade empty school", s.grade(1), [])
s = School()
for n, g in [("Peter",2),("Zoe",2),("Alex",2),("Jim",3)]: s.add_student(name=n, grade=g)
check("grade no students in grade", s.grade(1), [])
s = School()
for n in ("Blair","James","James","Paul"): s.add_student(name=n, grade=2)
check("grade not added same grade twice", s.grade(2), ["Blair","James","Paul"])
s = School()
for n, g in [("Franklin",5),("Bradley",5),("Jeff",1)]: s.add_student(name=n, grade=g)
check("grade sorted by name", s.grade(5), ["Bradley","Franklin"])

print("\nALL CHECKS PASSED")
