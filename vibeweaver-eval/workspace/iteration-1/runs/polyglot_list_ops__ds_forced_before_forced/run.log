import sys
import list_ops as lo

PASS = 0
FAIL = 0
FAILED = []

def check(name, actual, expected):
    global PASS, FAIL
    if actual == expected:
        PASS += 1
        print(f"PASS  {name}")
    else:
        FAIL += 1
        FAILED.append(name)
        print(f"FAIL  {name}: expected {expected!r}, got {actual!r}")

check("append_empty_lists", lo.append([], []), [])
check("append_list_to_empty", lo.append([], [1, 2, 3, 4]), [1, 2, 3, 4])
check("append_empty_to_list", lo.append([1, 2, 3, 4], []), [1, 2, 3, 4])
check("append_non_empty", lo.append([1, 2], [2, 3, 4, 5]), [1, 2, 2, 3, 4, 5])
check("concat_empty", lo.concat([]), [])
check("concat_list_of_lists", lo.concat([[1, 2], [3], [], [4, 5, 6]]), [1, 2, 3, 4, 5, 6])
check("concat_nested_one_level", lo.concat([[[1], [2]], [[3]], [[]], [[4, 5, 6]]]), [[1], [2], [3], [], [4, 5, 6]])
check("filter_empty", lo.filter(lambda x: x % 2 == 1, []), [])
check("filter_non_empty", lo.filter(lambda x: x % 2 == 1, [1, 2, 3, 5]), [1, 3, 5])
check("length_empty", lo.length([]), 0)
check("length_non_empty", lo.length([1, 2, 3, 4]), 4)
check("map_empty", lo.map(lambda x: x + 1, []), [])
check("map_non_empty", lo.map(lambda x: x + 1, [1, 3, 5, 7]), [2, 4, 6, 8])
check("foldl_empty", lo.foldl(lambda acc, el: el * acc, [], 2), 2)
check("foldl_direction_independent", lo.foldl(lambda acc, el: el + acc, [1, 2, 3, 4], 5), 15)
check("foldl_direction_dependent", lo.foldl(lambda acc, el: el / acc, [1, 2, 3, 4], 24), 64)
check("foldr_empty", lo.foldr(lambda acc, el: el * acc, [], 2), 2)
check("foldr_direction_independent", lo.foldr(lambda acc, el: el + acc, [1, 2, 3, 4], 5), 15)
check("foldr_direction_dependent", lo.foldr(lambda acc, el: el / acc, [1, 2, 3, 4], 24), 9)
check("foldr_strings", lo.foldr(lambda acc, el: el + acc, ["e", "x", "e", "r", "c", "i", "s", "m"], "!"), "exercism!")
